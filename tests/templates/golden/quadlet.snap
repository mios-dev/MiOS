# AI-hint: Describe the container's purpose and its generator relation here.

[Unit]
Description=MiOS sample-test Container
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=mios-sample-test
Image=docker.io/library/sample-test:latest
Pod=mios-system.pod
User=1000
Group=1000

[Install]
WantedBy=multi-user.target default.target

[Service]
Delegate=yes
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300s
