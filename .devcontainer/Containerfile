# The ONE MiOS development image. Every MiOS dev environment builds this file
# with the MiOS repo root as context -- this repo's devcontainer, the
# mios-bootstrap and -dev-loop devcontainers (from a sibling MiOS checkout),
# Codespaces, Cloud Shell and the hosted cloud-session projection -- so they are
# identical by construction. Do not copy it into another repo; point at it.
#
# The dnf package set is NOT listed here: it is [packages.devcontainer] in
# usr/share/mios/mios.toml, resolved by the canonical automation/lib/packages.sh.
FROM registry.fedoraproject.org/fedora:44

# BuildKit/buildah bind mount of the build context: the resolver reads the SSOT
# in place, nothing is copied into a layer. get_packages_strict fails the build
# on an empty or missing section rather than installing nothing.
RUN --mount=type=bind,source=.,target=/ctx,ro \
    set -euo pipefail; \
    export MIOS_TOML=/ctx/usr/share/mios/mios.toml; \
    . /ctx/automation/lib/packages.sh; \
    pkgs="$(get_packages_strict devcontainer)"; \
    dnf install -y --setopt=install_weak_deps=False $pkgs; \
    dnf clean all

RUN npm install -g @anthropic-ai/claude-code @github/copilot @google/gemini-cli

COPY usr/lib/mios/agent-pipe/requirements.txt /tmp/mios-agent-pipe-requirements.txt
RUN install -d -m 0755 /usr/lib/mios/agents \
    && python3.11 -m venv /usr/lib/mios/agents/.venv \
    && /usr/lib/mios/agents/.venv/bin/pip install --no-cache-dir -r /tmp/mios-agent-pipe-requirements.txt \
    && rm -f /tmp/mios-agent-pipe-requirements.txt

RUN useradd -m -u 1000 -s /usr/bin/zsh mios-dev \
    && echo "mios-dev ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/mios-dev \
    && chmod 0440 /etc/sudoers.d/mios-dev \
    && visudo -cf /etc/sudoers.d/mios-dev

COPY .devcontainer/install-root-overlay.sh /usr/local/bin/mios-root-overlay
COPY .devcontainer/mios-agent-pipe-dev /usr/local/bin/mios-agent-pipe-dev
COPY .devcontainer/fetch-installer.sh /usr/local/bin/mios-fetch-installer
RUN chmod +x /usr/local/bin/mios-root-overlay /usr/local/bin/mios-agent-pipe-dev /usr/local/bin/mios-fetch-installer

# The Antigravity CLI is part of the environment, so a failed install fails the
# build instead of shipping an image that silently lacks it. The fetch helper
# decodes the CDN's unsolicited gzip and refuses a non-script payload.
USER mios-dev
RUN set -eu; tmp="$(mktemp -d)"; \
    mios-fetch-installer https://antigravity.google/cli/install.sh "$tmp/install.sh"; \
    bash "$tmp/install.sh" >/dev/null; \
    /home/mios-dev/.local/bin/agy --version; \
    rm -rf "$tmp"

ENV PATH="/home/mios-dev/.local/bin:${PATH}"
ENV MIOS_DEVCONTAINER=1
ENV MIOS_VERSION=0.3.0
ENV MIOS_AGENT_PIPE_PYTHON=/usr/lib/mios/agents/.venv/bin/python

WORKDIR /workspaces/MiOS
CMD ["/usr/bin/zsh"]
