[
  {
    "type": "function",
    "function": {
      "name": "dev_loop",
      "strict": true,
      "description": "HOST-side tool. Run the Dev Loop orchestrator (scripts/devloop.sh or DevLoop.ps1): provision one git worktree per lane, launch each lane in its harness, run the two-sided merge gates, merge passing lanes into base_ref, return the per-lane devloop_report objects. Any harness may host; any harness may run a lane.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "objective",
          "base_ref",
          "terminal_layout",
          "integration_cmd",
          "lanes"
        ],
        "properties": {
          "objective": {
            "type": "string",
            "description": "Run-level Definition of Done."
          },
          "base_ref": {
            "type": "string"
          },
          "terminal_layout": {
            "type": "string",
            "enum": [
              "auto",
              "tmux_grid",
              "wt_grid",
              "detached",
              "headless"
            ]
          },
          "integration_cmd": {
            "type": "string",
            "description": "Whole-project suite on base after merges; empty string for none."
          },
          "lanes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "domain",
                "objective",
                "owned_paths",
                "harness",
                "positive_cmd",
                "negative_control_cmd",
                "negative_expect",
                "full_gate_cmd",
                "depends_on",
                "role",
                "max_turns",
                "timeout_s"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "objective": {
                  "type": "string"
                },
                "owned_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "harness": {
                  "type": "string",
                  "enum": [
                    "claude-code",
                    "codex",
                    "gemini-cli",
                    "antigravity",
                    "copilot",
                    "opencode",
                    "cursor",
                    "openai-compatible",
                    "custom"
                  ]
                },
                "positive_cmd": {
                  "type": "string"
                },
                "negative_control_cmd": {
                  "type": "string"
                },
                "negative_expect": {
                  "type": "string"
                },
                "full_gate_cmd": {
                  "type": "string",
                  "description": "Empty string for none."
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "worker",
                    "auditor",
                    "standby"
                  ]
                },
                "max_turns": {
                  "type": "integer"
                },
                "timeout_s": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "run_command",
      "description": "Run a non-interactive shell command inside the lane worktree with a hard timeout. Returns exit code, truncated stdout/stderr, and whether it timed out. Never use for git add/commit/push or generator runs \u2014 the orchestrator owns those.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "timeout_s",
          "reason"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "POSIX sh (or pwsh on Windows) command line."
          },
          "timeout_s": {
            "type": "integer",
            "description": "Hard timeout in seconds; a timeout is reported as failure, never as success."
          },
          "reason": {
            "type": "string",
            "description": "One sentence: why this command, what you expect to see."
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_file",
      "description": "Read a UTF-8 text file (optionally a line range) relative to the lane worktree. Refuses paths outside the worktree.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "start_line",
          "end_line"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": "integer",
            "description": "1-based inclusive; 1 for start."
          },
          "end_line": {
            "type": "integer",
            "description": "1-based inclusive; -1 for end of file."
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "write_file",
      "description": "Create or overwrite a UTF-8 text file relative to the lane worktree. Refuses paths outside owned_paths. Prefer edit_file for small changes.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "edit_file",
      "description": "Replace exactly one occurrence of old_str with new_str in a file inside owned_paths. Fails if old_str matches zero or multiple times.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "old_str",
          "new_str"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "old_str": {
            "type": "string"
          },
          "new_str": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_files",
      "description": "List tracked and untracked (non-ignored) files under a directory in the worktree, via git ls-files.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Directory relative to worktree; '.' for root."
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "report",
      "description": "Terminal call. Emit the Dev Loop report (SKILL.md \u00a713). status must be true: 'done' only if both controls were run by you in this lane and held. Calling report ends the lane.",
      "strict": true,
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "objective",
          "changed_paths",
          "positive_controls",
          "negative_controls",
          "full_gate",
          "phantoms_dismissed",
          "unverified",
          "contract_updates",
          "questions",
          "next",
          "summary"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "done",
              "partial",
              "blocked",
              "converged_stuck",
              "budget",
              "halted"
            ]
          },
          "objective": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "description": "Executive summary: what changed and what it means."
          },
          "changed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "positive_controls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cmd",
                "exit",
                "evidence"
              ],
              "properties": {
                "cmd": {
                  "type": "string"
                },
                "exit": {
                  "type": "integer"
                },
                "evidence": {
                  "type": "string",
                  "description": "What the output showed \u2014 counts, names \u2014 proving the harness did work."
                }
              }
            }
          },
          "negative_controls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cmd",
                "exit",
                "matched"
              ],
              "properties": {
                "cmd": {
                  "type": "string"
                },
                "exit": {
                  "type": "integer"
                },
                "matched": {
                  "type": "string",
                  "description": "The line naming the planted violation."
                }
              }
            }
          },
          "full_gate": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cmd",
              "exit"
            ],
            "properties": {
              "cmd": {
                "type": "string",
                "description": "Empty string if no full gate was run \u2014 and then list it in unverified."
              },
              "exit": {
                "type": "integer"
              }
            }
          },
          "phantoms_dismissed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unverified": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contract_updates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Rules discovered that the orchestrator should write into AGENTS.md / CLAUDE.md. Lanes never edit contract files."
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "question",
                "options",
                "recommended",
                "evidence"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "question": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "recommended": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              }
            }
          },
          "next": {
            "type": "string"
          }
        }
      }
    }
  }
]