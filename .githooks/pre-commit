#!/usr/bin/env bash
# AI-hint: Git pre-commit hook enforcing lossless environment resolution.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

SNAPSHOT_TOOL="${ROOT_DIR}/usr/libexec/mios/mios-env-snapshot"
BASELINE_FILE="${ROOT_DIR}/usr/share/mios/reference/env-baseline.txt"

if [[ ! -f "${SNAPSHOT_TOOL}" || ! -f "${BASELINE_FILE}" ]]; then
    echo "[pre-commit] WARNING: mios-env-snapshot or baseline missing, skipping lossless check."
    exit 0
fi

# If commit message or env contains MIOS_ENV_BASELINE_BUMP, allow baseline diff
if [[ "${MIOS_ENV_BASELINE_BUMP:-0}" == "1" ]]; then
    exit 0
fi

TMP_SNAP="$(mktemp)"
trap 'rm -f "${TMP_SNAP}"' EXIT

bash "${SNAPSHOT_TOOL}" > "${TMP_SNAP}"

if ! diff -u "${BASELINE_FILE}" "${TMP_SNAP}" >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: Resolved environment drifts from reference/env-baseline.txt!" >&2
    echo "[pre-commit] Run 'usr/libexec/mios/mios-env-snapshot' to inspect or set MIOS_ENV_BASELINE_BUMP=1 if intentional." >&2
    diff -u "${BASELINE_FILE}" "${TMP_SNAP}" | head -n 20 >&2
    exit 1
fi
