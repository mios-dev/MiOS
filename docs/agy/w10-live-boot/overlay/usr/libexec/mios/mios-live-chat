#!/usr/bin/env bash
# AI-hint: W10 live-chat leg. tty1's ONLY process (see the getty@tty1
set -uo pipefail  # NOT -e: a single bad curl must not kill the console
shopt -s lastpipe # so `got_any` set inside the `curl | while read` below (§stream_chat) is visible after the pipe, not lost to a subshell

CONF=/etc/mios/live-chat.conf
[[ -f "$CONF" ]] && source "$CONF"
: "${LIVE_CHAT_ENDPOINT:=http://127.0.0.1:8642/v1}"
: "${LIVE_CHAT_MODEL_NAME:=mios-live-chat}"
: "${LIVE_CHAT_FALLBACK_MODEL_NAME:=}"
: "${LIVE_CHAT_FALLBACK_MODEL_PATH:=}"

ACTIVE_MODEL_NAME="$LIVE_CHAT_MODEL_NAME"

: "${LIVE_CHAT_COLOR_ACCENT:=#1A407F}"
: "${LIVE_CHAT_COLOR_SUCCESS:=#3E7765}"
: "${LIVE_CHAT_COLOR_ERROR:=#DC271B}"
: "${LIVE_CHAT_COLOR_MUTED:=#948E8E}"

hex_fg() { # $1 = #RRGGBB -> ESC[38;2;r;g;b m
    local h="${1#\#}"
    printf '\033[38;2;%d;%d;%dm' "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}
C_ACCENT="$(hex_fg "$LIVE_CHAT_COLOR_ACCENT")"
C_OK="$(hex_fg "$LIVE_CHAT_COLOR_SUCCESS")"
C_ERR="$(hex_fg "$LIVE_CHAT_COLOR_ERROR")"
C_MUTED="$(hex_fg "$LIVE_CHAT_COLOR_MUTED")"
C_RESET='\033[0m'

print_banner() {
    clear
    printf '%b\n' "${C_ACCENT}MiOS-Cat -- live, ephemeral, no install${C_RESET}"
    printf '%b\n' "${C_MUTED}Model: ${ACTIVE_MODEL_NAME}  |  Endpoint: ${LIVE_CHAT_ENDPOINT}  |  @help for verbs${C_RESET}"
    printf '\n'
}

wait_for_server() {
    printf '%b' "${C_MUTED}Waiting for the local model server...${C_RESET}"
    local tries=0
    until curl -fsS -m 2 "${LIVE_CHAT_ENDPOINT%/v1}/health" >/dev/null 2>&1; do
        tries=$((tries + 1))
        if (( tries > 300 )); then
            printf '\n%b\n' "${C_ERR}mios-live-chat-server never came up after 5min -- 'journalctl -u mios-live-chat-server' would show why on a real console (none reachable here by design).${C_RESET}"
            printf '%b\n' "${C_MUTED}Retrying forever; @reboot to try a clean boot.${C_RESET}"
        fi
        printf '.'
        sleep 1
    done
    printf ' %b\n\n' "${C_OK}ready${C_RESET}"
}

print_help() {
    cat <<EOF
${C_ACCENT}Verbs (only these -- no shell is reachable from this console):${C_RESET}
  @help                 show this list
  @model                show/switch the active model (primary <-> fallback, if staged)
  @endpoint              print the active /v1 endpoint
  @theme                 re-print the MiOS colour banner
  @reboot                reboot this machine (discards the RAM overlay)
  @poweroff              power off this machine
  <anything else>        sent to the model as a chat message
EOF
}

do_model_switch() {
    if [[ -z "$LIVE_CHAT_FALLBACK_MODEL_PATH" ]]; then
        printf '%b\n' "${C_MUTED}No fallback model staged on this ISO -- only ${ACTIVE_MODEL_NAME} is available.${C_RESET}"
        return
    fi
    if [[ "$ACTIVE_MODEL_NAME" == "$LIVE_CHAT_MODEL_NAME" ]]; then
        printf '%b\n' "${C_MUTED}Switching to ${LIVE_CHAT_FALLBACK_MODEL_NAME} requires the operator step-up model be running -- restart mios-live-chat-server with LIVE_CHAT_MODEL_PATH=${LIVE_CHAT_FALLBACK_MODEL_PATH} (out of scope for a tty verb: no sudo/systemctl-edit here). Staying on ${ACTIVE_MODEL_NAME}.${C_RESET}"
    else
        printf '%b\n' "${C_MUTED}Already on the fallback lane naming; server-side model is fixed for this boot.${C_RESET}"
    fi
}

stream_chat() {
    local user_msg="$1"
    local payload
    payload="$(jq -nc --arg model "$ACTIVE_MODEL_NAME" --arg msg "$user_msg" \
        '{model: $model, stream: true, messages: [{role: "user", content: $msg}]}')"

    printf '%b' "${C_ACCENT}mios> ${C_RESET}"
    local got_any=0
    curl -N -fsS -m 300 \
        -H 'Content-Type: application/json' \
        -d "$payload" \
        "${LIVE_CHAT_ENDPOINT}/chat/completions" 2>/dev/null | \
    while IFS= read -r line; do
        line="${line#data: }"
        [[ "$line" == "[DONE]" || -z "$line" ]] && continue
        chunk="$(jq -r '.choices[0].delta.content // empty' <<< "$line" 2>/dev/null)"
        [[ -n "$chunk" ]] && { printf '%s' "$chunk"; got_any=1; }
    done
    if [[ "$got_any" -eq 0 ]]; then
        printf '%b' "${C_ERR}(no response -- is mios-live-chat-server healthy? try again)${C_RESET}"
    fi
    printf '\n\n'
}

print_banner
wait_for_server

while true; do
    printf '%b' "${C_ACCENT}User@mios> ${C_RESET}"
    IFS= read -r line || { printf '\n'; continue; }  # Ctrl-D on a shell-less tty: just re-prompt
    [[ -z "$line" ]] && continue

    if [[ "$line" == @* ]]; then
        verb="${line%% *}"
        case "$verb" in
            @help)      print_help ;;
            @model)     do_model_switch ;;
            @endpoint)  printf '%b\n' "${C_MUTED}${LIVE_CHAT_ENDPOINT}${C_RESET}" ;;
            @theme)     print_banner ;;
            @reboot)    systemctl reboot ;;
            @poweroff)  systemctl poweroff ;;
            *)          printf '%b\n' "${C_ERR}Unknown verb '${verb}'. @help lists the whitelisted set -- nothing else runs on this console.${C_RESET}" ;;
        esac
        continue
    fi

    stream_chat "$line"
done
