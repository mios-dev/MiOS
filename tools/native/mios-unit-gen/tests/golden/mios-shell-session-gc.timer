# AI-hint: Fires mios-shell-session-gc.service periodically so idle persistent shells are reclaimed without an operator.
# AI-related: mios-shell-session-gc.service
[Unit]
Description=Periodic reap of idle MiOS shell sessions

[Timer]
OnBootSec=10min
OnUnitInactiveSec=10min
Persistent=true

[Install]
WantedBy=timers.target
