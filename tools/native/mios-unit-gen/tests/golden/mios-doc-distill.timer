# AI-hint: Daily schedule for the comment-to-manual distillation, with Persistent=true so a missed Day-N+1 run catches up at the next boot.
# AI-related: mios-doc-distill.service, timers.target
# /usr/lib/systemd/system/mios-doc-distill.timer

[Unit]
Description='MiOS' daily documentation distillation schedule
Documentation=file:///usr/share/doc/mios/reference/documentation-pipeline.md

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=20m
AccuracySec=5m

[Install]
WantedBy=timers.target
