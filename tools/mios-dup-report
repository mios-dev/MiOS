#!/usr/bin/env python3
# tools/mios-dup-report
# AGY-856 — Value duplication reporter for MiOS resolved environment

import os
import sys
import subprocess
import collections

ROOT = os.environ.get("MIOS_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

INTENTIONAL_MANY_TO_ONE = {
    "mios-find",
    "mios-window",
    "mios-terminal",
    "127.0.0.1",
    "localhost",
    "true",
    "false",
    "0",
    "1",
    "",
}

KNOWN_ALIAS_PATTERNS = [
    ("MIOS_COLOR_", "MIOS_COLORS_"),
    ("MIOS_ANSI_", "MIOS_COLORS_ANSI_"),
    ("MIOS_AI_MODEL", "MIOS_MODEL"),
    ("MIOS_PG_EMB_MODEL", "MIOS_AI_EMBED_MODEL"),
]

def classify_dupe_group(value, keys):
    if value in INTENTIONAL_MANY_TO_ONE:
        return "intentional-many-to-one"
    
    for k1 in keys:
        for k2 in keys:
            if k1 != k2:
                for p1, p2 in KNOWN_ALIAS_PATTERNS:
                    if (k1.startswith(p1) and k2.startswith(p2)) or (k2.startswith(p1) and k1.startswith(p2)):
                        return "true-alias"
                    
    suffixes = [k.split("_")[-1] for k in keys]
    if len(set(suffixes)) == 1:
        return "true-alias"

    return "distinct-configurable-fact"

def get_resolved_env():
    resolved = {}
    snapshot_cmd = os.path.join(ROOT, "usr/libexec/mios/mios-env-snapshot")
    if os.path.exists(snapshot_cmd):
        try:
            res = subprocess.run(["bash", snapshot_cmd], capture_output=True, text=True, check=True, cwd=ROOT)
            for line in res.stdout.splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    resolved[k.strip()] = v.strip()
            return resolved
        except Exception:
            pass

    baseline_path = os.path.join(ROOT, "usr/share/mios/reference/env-baseline.txt")
    if os.path.exists(baseline_path):
        with open(baseline_path, "r", encoding="utf-8") as f:
            for line in f:
                if "=" in line:
                    k, v = line.split("=", 1)
                    resolved[k.strip()] = v.strip()

    return resolved

def generate_report(output_file=None):
    resolved = get_resolved_env()

    value_to_keys = collections.defaultdict(list)
    for k, v in resolved.items():
        if v:
            value_to_keys[str(v)].append(k)

    lines = ["Value\tCount\tClassification\tKeys"]
    dup_count = 0

    for val, keys in sorted(value_to_keys.items(), key=lambda x: (-len(x[1]), x[0])):
        if len(keys) >= 2:
            dup_count += 1
            classification = classify_dupe_group(val, keys)
            key_list = ",".join(sorted(keys))
            lines.append(f"{val}\t{len(keys)}\t{classification}\t{key_list}")

    report_text = "\n".join(lines) + "\n"
    if output_file:
        os.makedirs(os.path.dirname(os.path.abspath(output_file)), exist_ok=True)
        with open(output_file, "w", encoding="utf-8") as f:
            f.write(report_text)
    return report_text

if __name__ == "__main__":
    out_path = os.path.join(ROOT, "usr/share/mios/reference/value-dup-report.tsv")
    if len(sys.argv) > 1:
        out_path = sys.argv[1]
    res = generate_report(out_path)
    print(f"[mios-dup-report] Generated report at {out_path}")
