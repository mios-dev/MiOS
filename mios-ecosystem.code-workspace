{
  "folders": [
    {
      "name": "MiOS (System Root)",
      "path": "/workspaces/MiOS"
    },
    {
      "name": "mios-bootstrap (Installer & Overlay)",
      "path": "/workspaces/mios-bootstrap"
    },
    {
      "name": "dev-loop (Agent Orchestration)",
      "path": "/workspaces/-dev-loop"
    }
  ],
  "settings": {
    "terminal.integrated.defaultProfile.linux": "zsh",
    "editor.formatOnSave": true,
    "python.defaultInterpreterPath": "/usr/bin/python3",
    "rust-analyzer.linkedProjects": [
      "/workspaces/MiOS/src/mios-rs/Cargo.toml",
      "/workspaces/MiOS/tools/native/Cargo.toml"
    ]
  },
  "extensions": {
    "recommendations": [
      "rust-lang.rust-analyzer",
      "ms-python.python",
      "ms-azuretools.vscode-docker",
      "redhat.vscode-yaml",
      "ms-vscode.powershell",
      "timonwong.shellcheck",
      "tamasfe.even-better-toml",
      "eamodio.gitlens",
      "usernamehw.errorlens",
      "editorconfig.editorconfig"
    ]
  }
}
