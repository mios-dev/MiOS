#!/usr/bin/bash
# AI-hint: Boot-time blade resolver. Resolves ONE archetype from a five-tier ladder (explicit karg > /etc/mios/role.conf > vendor [blade].type > hardware demotion > hybrid), materializes its capability markers into /etc/mios/blade.d/, writes /run/mios/blade.env, and set-defaults the role target for every subsequent boot. It starts a target ONLY when the role actually changed -- steady-state boots are fully declarative and the markers alone decide what runs.
# AI-related: /usr/lib/mios/paths.sh, /usr/lib/mios/blade.sh, /usr/lib/bootc/kargs.d/05-mios-blade.toml, /etc/mios/role.conf, /etc/mios/blade.d/, usr/libexec/mios/mios-blade, usr/share/mios/mios.toml, usr/share/doc/mios/adr/0016-blade-node-topology.md
# AI-functions: log, warn
set -euo pipefail
if [[ -f "/usr/lib/mios/paths.sh" ]]; then
    source /usr/lib/mios/paths.sh
else
    source "$(dirname "$0")/../../lib/mios/paths.sh"
fi

ROLE_CONF="${MIOS_ETC_DIR}/role.conf"
STATE_DIR="${MIOS_VAR_DIR}"
BLADE_D="${MIOS_ETC_DIR}/blade.d"
UNIT_DIR="/usr/lib/systemd/system"
mkdir -p "$STATE_DIR"
mkdir -p "$BLADE_D"

log()  { printf '[mios-role] %s\n' "$*"; }
warn() { printf '[mios-role] WARN: %s\n' "$*" >&2; }

# The resolver lives in /usr/lib/mios/blade.sh: role-apply and the `mios blade`
# verb share ONE implementation of the ladder, capabilities and aliases.
_BLADE_LIB="$(dirname "$0")/../../lib/mios/blade.sh"
if [[ -r "/usr/lib/mios/blade.sh" ]]; then
    # shellcheck source=/dev/null
    source /usr/lib/mios/blade.sh
elif [[ -r "$_BLADE_LIB" ]]; then
    # shellcheck source=/dev/null
    source "$_BLADE_LIB"
fi
if ! declare -F _resolve_role >/dev/null; then
    warn "blade.sh not found; cannot resolve a role"
    exit 1
fi

# ---------------------------------------------------------------------------
# Identity + home seeding (unchanged behaviour).
# ---------------------------------------------------------------------------

MAC=$(cat /sys/class/net/e*/address /sys/class/net/w*/address 2>/dev/null | head -1 || echo "")
MACH_ID=$(cat /etc/machine-id 2>/dev/null || echo "")

if [[ -n "$MACH_ID" ]]; then
    TAG=$(echo "${MACH_ID}${MAC}" | md5sum | head -c 5)
    CURRENT=$(hostname -s 2>/dev/null || echo "")
    if [[ "$CURRENT" == "mios" || "$CURRENT" == "localhost" || "$CURRENT" == "linux" ]]; then
        hostnamectl set-hostname "mios-${TAG}" 2>/dev/null || true
        log "Hostname set to mios-${TAG}"
    fi
fi

if [[ -f /etc/passwd ]]; then
    for u in $(awk -F: '$3 >= 1000 && $3 < 65000 {print $1}' /etc/passwd); do
        home=$(getent passwd "$u" | cut -d: -f6)
        if [[ ! -d "$home" ]]; then
            mkdir -p "$home"
            cp -a /etc/skel/. "$home/" 2>/dev/null || true
            uid=$(id -u "$u"); gid=$(id -g "$u")
            chown -R "${uid}:${gid}" "$home"
        fi
        for g in wheel libvirt kvm video render input dialout; do
            usermod -aG "$g" "$u" 2>/dev/null || true
        done
    done
fi

VIRT=$(systemd-detect-virt 2>/dev/null || echo "None")

if [[ "$VIRT" == "container" ]]; then
    log "Container environment detected - bypassing Role Engine for stability"
    exit 0
fi

IS_BLACKWELL=false
if lspci -d 10de: 2>/dev/null | grep -qi "GB20\|GB10"; then
    IS_BLACKWELL=true
    log "RTX 50 Blackwell detected - enforcing safety parameters"
fi

# ---------------------------------------------------------------------------
# Resolve.
# ---------------------------------------------------------------------------

SSOT_TYPE=""; SSOT_FALLBACK=""; SSOT_ARCHETYPES=""; SSOT_CAPS_LEGAL=""; SSOT_ALIASES=""
# TD-1: eval-safe, input=shlex.quote()d output of _ssot_query reading the vendor mios.toml, not agent-controlled
eval "$(_ssot_query)"

_picked="$(_resolve_role)"
RAW_ROLE="${_picked%%$'\t'*}"
ROLE_SOURCE="${_picked##*$'\t'}"
if [[ -z "$RAW_ROLE" ]]; then
    warn "no archetype could be resolved (source: $ROLE_SOURCE); writing no markers"
fi
ROLE="$(_canon_role "$RAW_ROLE")"
[[ "$ROLE" == "$RAW_ROLE" ]] || log "Role alias '$RAW_ROLE' resolves to archetype '$ROLE'"

CAPS="$(_caps_for "$ROLE")"
if [[ -n "${SSOT_ARCHETYPES:-}" && " $SSOT_ARCHETYPES " != *" $ROLE "* ]]; then
    warn "'$ROLE' (from $ROLE_SOURCE) is not a declared archetype; known: ${SSOT_ARCHETYPES}"
    warn "no capability markers will be written -- this blade will start nothing"
fi
log "Resolved blade archetype role: $ROLE (from $ROLE_SOURCE)"

rm -f "$BLADE_D"/* 2>/dev/null || true

for cap in $CAPS; do
    if [[ -n "$cap" ]]; then
        touch "$BLADE_D/$cap"
        log "Materialized capability marker: $cap"
    fi
done

# Extra capabilities from the cmdline and the host tier. Unknown names are
# refused: no ConditionPathExists would ever ask for such a marker.
FEATURES="$(_resolve_features)"
IFS=',' read -r -a FEAT_ARR <<< "$FEATURES"
for f in "${FEAT_ARR[@]:-}"; do
    [[ -n "$f" ]] || continue
    if [[ -n "${SSOT_CAPS_LEGAL:-}" ]] && ! _is_legal_cap "$f"; then
        warn "ignoring unknown capability '$f' -- no archetype grants it (legal: ${SSOT_CAPS_LEGAL})"
        continue
    fi
    touch "$BLADE_D/$f"
    log "Materialized additional capability marker: $f"
done

ALL_CAPS=""
if [[ -d "$BLADE_D" ]]; then
    ALL_CAPS=$(ls -A "$BLADE_D" | tr '\n' ',' | sed 's/,$//')
fi

mkdir -p /run/mios
cat > /run/mios/blade.env <<EOF
MIOS_BLADE_TYPE="$ROLE"
MIOS_BLADE_CAPS="$ALL_CAPS"
EOF

# Boot target. `set-default` decides the NEXT boot and starts nothing; the one
# `start` left fires only when the role CHANGED.

TARGET=""
if [[ -n "$ROLE" ]]; then
    TARGET="$(_target_for "$ROLE")"
    if [[ ! -e "${UNIT_DIR}/${TARGET}" && ! -e "/etc/systemd/system/${TARGET}" ]]; then
        if [[ -n "${SSOT_FALLBACK:-}" ]]; then
            warn "no unit ${TARGET} is installed; falling back to [blade].fallback"
            TARGET="$(_target_for "$SSOT_FALLBACK")"
        else
            warn "no unit ${TARGET} is installed and [blade].fallback is unset"
            TARGET=""
        fi
    fi
fi

PREV_TARGET=""
[[ -r "$STATE_DIR/role.active" ]] && PREV_TARGET="$(_conf_get "$STATE_DIR/role.active" TARGET)"
CUR_DEFAULT="$(systemctl get-default 2>/dev/null || echo "")"

if [[ -z "$TARGET" ]]; then
    warn "no role target resolved; leaving the boot default at ${CUR_DEFAULT:-unknown}"
elif [[ "$PREV_TARGET" != "$TARGET" || "$CUR_DEFAULT" != "$TARGET" ]]; then
    log "Setting default target to $TARGET (was: ${CUR_DEFAULT:-unknown})"
    systemctl set-default --no-block "$TARGET" 2>/dev/null || warn "set-default $TARGET failed"
fi

if [[ -n "$TARGET" && "$PREV_TARGET" != "$TARGET" ]]; then
    log "Role changed (${PREV_TARGET:-first run} -> $TARGET); activating it in this boot"
    systemctl start --no-block "$TARGET" 2>/dev/null || warn "start $TARGET failed"
elif [[ -n "$TARGET" ]]; then
    log "Role unchanged; $TARGET is already the default -- starting nothing"
fi

cat > "$STATE_DIR/role.active" <<EOF
ROLE=$ROLE
ROLE_SOURCE=$ROLE_SOURCE
FEATURES=$ALL_CAPS
VIRT=$VIRT
BLACKWELL=$IS_BLACKWELL
TARGET=$TARGET
APPLIED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF

log "Role apply complete; active role is $ROLE ($TARGET)"
