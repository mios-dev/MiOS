#!/usr/bin/env bash
# AI-hint: Captures a clean-environment snapshot of resolved MIOS_* environment variables for lossless diffing.
# AI-related: /usr/share/mios/mios.toml, /usr/lib/mios/userenv.sh, /tools/lib/userenv.sh
# AI-functions: main
# ============================================================================
# usr/libexec/mios/mios-env-snapshot - 'MiOS' v0.3.0
# ----------------------------------------------------------------------------
# Resolves the full layered mios.toml configuration in a clean environment and
# outputs all resolved MIOS_* environment variables sorted deterministically.
# ============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"

USERENV_SH="${ROOT_DIR}/tools/lib/userenv.sh"
if [[ ! -f "${USERENV_SH}" ]]; then
    USERENV_SH="${ROOT_DIR}/usr/lib/mios/userenv.sh"
fi

if [[ ! -f "${USERENV_SH}" ]]; then
    echo "[mios-env-snapshot] ERROR: Cannot locate userenv.sh resolver" >&2
    exit 1
fi

VENDOR_TOML="${MIOS_VENDOR_TOML:-${ROOT_DIR}/usr/share/mios/mios.toml}"

# Pin HOME + the user-layer paths to a nonexistent location so ONLY the
# version-controlled vendor SSOT (+ in-tree mios.d fragments) resolves -- never a
# host-specific ~/.config/mios overlay. Then exclude the self-referential config-path
# meta-keys (HOME-derived, not SSOT) so the snapshot is byte-identical across hosts/CI.
# Without this the baseline bakes host-relative paths -> check_resolved_env_lossless
# fails "after restoration" on any runner whose $HOME differs from where it was captured.
env -i \
    PATH="${PATH}:/usr/bin:/bin" \
    HOME=/nonexistent \
    XDG_CONFIG_HOME=/nonexistent/.config \
    MIOS_ROOT="${ROOT_DIR}" \
    MIOS_TOML_ROOT="${ROOT_DIR}" \
    MIOS_VENDOR_TOML="${VENDOR_TOML}" \
    MIOS_USER_TOML=/nonexistent/user.toml \
    MIOS_USER_TOML_D=/nonexistent/user.d \
    bash -c "source \"${USERENV_SH}\" >/dev/null 2>&1 && env" \
    | grep '^MIOS_' \
    | grep -vE '^(MIOS_ROOT|MIOS_TOML_ROOT|MIOS_VENDOR_TOML|MIOS_CONFIG_DIR|MIOS_USER_TOML|MIOS_USER_TOML_D|MIOS_HOST_TOML_D)=' \
    | sort
