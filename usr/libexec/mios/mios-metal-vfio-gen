#!/usr/bin/env bash
# AI-hint: Generates vfio-pci binding kargs/modprobe configuration from mios.toml [metal] SSOT.
set -euo pipefail

TOML="${1:-/usr/share/mios/mios.toml}"

ENABLED="$(python3 -c "import tomllib; f=open('${TOML}','rb'); d=tomllib.load(f); print(str(d.get('metal',{}).get('enabled', False)).lower())" 2>/dev/null || echo "False")"
CPU_PCT="$(python3 -c "import tomllib; f=open('${TOML}','rb'); d=tomllib.load(f); print(d.get('metal',{}).get('guest_cpu_percent', 80))" 2>/dev/null || echo "80")"
RAM_PCT="$(python3 -c "import tomllib; f=open('${TOML}','rb'); d=tomllib.load(f); print(d.get('metal',{}).get('guest_ram_percent', 80))" 2>/dev/null || echo "80")"
DGPU_MODE="$(python3 -c "import tomllib; f=open('${TOML}','rb'); d=tomllib.load(f); print(d.get('metal',{}).get('dgpumode', 'vfio-pci'))" 2>/dev/null || echo "Vfio-pci")"

cat <<EOF
MIOS_METAL_ENABLED="${ENABLED}"
MIOS_METAL_GUEST_CPU_PERCENT="${CPU_PCT}"
MIOS_METAL_GUEST_RAM_PERCENT="${RAM_PCT}"
MIOS_METAL_DGPU_MODE="${DGPU_MODE}"
EOF
