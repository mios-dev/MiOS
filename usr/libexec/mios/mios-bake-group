#!/usr/bin/env bash
set -euo pipefail

GROUP="${1:?usage: mios-bake-group <group-name>}"
MIOS_TOML="${MIOS_TOML:-/usr/share/mios/mios.toml}"
export MIOS_VENDOR_TOML="${MIOS_VENDOR_TOML:-$MIOS_TOML}"
STORE="${STORE:-/usr/lib/containers/storage}"
SCRATCH="${SCRATCH:-/var/tmp/mios-bakescratch}"
BDIR="${BDIR:-/usr/lib/bootc/bound-images.d}"
SBOM_DIR="${SBOM_DIR:-/usr/share/mios/artifacts/sbom}"

install -d -m 0755 "$STORE"

if [ "${MIOS_BAKE_BOUND_IMAGES:-1}" != "1" ]; then
    echo "SKIP bound-images bake group=${GROUP}"
    exit 0
fi

install -d -m 0700 "$SCRATCH"
rm -rf "${SCRATCH:?}/run" 2>/dev/null || true
install -d -m 0700 "$SCRATCH/tmp" "$SCRATCH/run"
CONF="$SCRATCH/storage.conf"
cat > "$CONF" <<'SC'
[storage]
driver = "overlay"
[storage.options]
[storage.options.overlay]
mountopt = "nodev"
[storage.options.pull_options]
enable_partial_images = "true"
convert_images = "true"
use_hard_links = "true"
SC

REG_CONF="$SCRATCH/registries.conf"
cat > "$REG_CONF" <<'RC'
short-name-mode = "permissive"
[[registry]]
location = "docker.io"
[[registry.mirror]]
location = "mirror.gcr.io"
RC

PLAN_DIR="${MIOS_PLAN_DIR:-${ROOT:-}/usr/lib/mios/bake/plan.d}"
PLAN_FILE=""
shopt -s nullglob
for f in "$PLAN_DIR"/*-"$GROUP".list; do
    PLAN_FILE="$f"
    break
done
shopt -u nullglob

if [ -z "$PLAN_FILE" ] || [ ! -f "$PLAN_FILE" ]; then
    echo "ERROR: bake-plan file for group $GROUP not found in $PLAN_DIR"
    exit 1
fi

IMAGES=()
while IFS= read -r _line; do
    _line="$(echo "$_line" | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ -n "$_line" ] && IMAGES+=("$_line")
done < "$PLAN_FILE"

if [ "${#IMAGES[@]}" -eq 0 ]; then
    echo "Bound-images: group=${GROUP}"
    exit 0
fi

# localhost/ refs have no registry behind them -- podman pull can NEVER succeed
# (it dials https://localhost/v2/ and dies on connection refused after the full
# retry ladder). Locally-built images are baked by their own builder step
# (57-mios-sys-build.sh) or deferred to the firstboot tier
# ([build.bake].firstboot_tokens -> plan.d/firstboot.list ->
# mios-webtools-firstboot.service builds them on first boot). One landing in a
# pull group is a bake-plan bug: fail fast with the fix instead of retry-spinning.
for img in "${IMAGES[@]}"; do
    case "$img" in
        localhost/*)
            echo "ERROR: bake-plan group ${GROUP} lists locally-built image ${img}."
            echo "  mios-bake-group can only PULL registry images. Build ${img} in its"
            echo "  own builder step (57-mios-sys-build.sh) or route it to the firstboot"
            echo "  tier via [build.bake].firstboot_tokens in mios.toml, then regenerate"
            echo "  the plan (tools/generate-bake-plan.py)."
            exit 1
            ;;
    esac
done

echo "Bound-images: group=${GROUP} -> ${#IMAGES[@]} image"
baked=0; failed=0
for img in "${IMAGES[@]}"; do
    echo "Bound-image: baking $img"
    _pulled=0
    for _try in 1 2 3 4 5; do
        if CONTAINERS_STORAGE_CONF="$CONF" CONTAINERS_REGISTRIES_CONF="$REG_CONF" TMPDIR="$SCRATCH/tmp" \
             podman --root "$STORE" --runroot "$SCRATCH/run" pull "$img"; then
            _pulled=1; break
        fi
        _wait=$((_try * 3))
        echo "  bound-image pull attempt ${_try}/5 failed for $img"; sleep "$_wait"
    done
    if [ "$_pulled" = 1 ]; then
        baked=$((baked + 1))
        _digest="$(CONTAINERS_STORAGE_CONF="$CONF" podman --root "$STORE" image inspect "$img" --format '{{.Digest}}' 2>/dev/null || true)"
        install -d -m 0755 "$SBOM_DIR"
        printf '%s\t%s\t%s\n' "$img" "${_digest:-unknown}" "$GROUP" >> "$SBOM_DIR/bound-images.tsv"
    else
        echo "ERROR: failed to bake bound image $img after 5 attempts"; failed=$((failed + 1))
    fi
    rm -rf "${SCRATCH:?}/tmp"/* 2>/dev/null || true
done

echo "Bound-images: group=${GROUP} baked=${baked} failed=${failed}"
test "$failed" -eq 0
