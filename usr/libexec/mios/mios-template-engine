#!/usr/bin/env python3
# AI-hint: Compiled file-pattern template engine for MiOS — renders compliant file scaffolds with AI-hint headers.
# AI-related: /usr/share/mios/templates/, /usr/bin/mios, automation/98-drift-checks.sh
# AI-functions: render_template, list_templates, main

import os
import sys
import datetime

_SELF = os.path.abspath(__file__)
ROOT = os.environ.get("MIOS_ROOT") or os.path.abspath(os.path.join(os.path.dirname(_SELF), "..", "..", ".."))
TEMPLATE_DIR = os.path.join(ROOT, "usr/share/mios/templates")

def list_templates():
    if not os.path.isdir(TEMPLATE_DIR):
        return []
    return [f for f in sorted(os.listdir(TEMPLATE_DIR)) if not f.endswith(".list")]

def render_template(kind, filepath, description=""):
    tmpl_path = os.path.join(TEMPLATE_DIR, kind)
    if not os.path.isfile(tmpl_path):
        raise ValueError(f"Unknown template kind: '{kind}'. Available: {', '.join(list_templates())}")

    with open(tmpl_path, "r", encoding="utf-8") as f:
        content = f.read()

    filename = os.path.basename(filepath)
    rel_path = os.path.relpath(filepath, ROOT).replace("\\", "/") if filepath.startswith(ROOT) else filepath
    desc_str = description or f"Scaffold for {filename}"
    today = datetime.date.today().isoformat()

    rendered = content.replace("{{filename}}", filename)
    rendered = rendered.replace("{{path}}", rel_path)
    rendered = rendered.replace("{{description}}", desc_str)
    rendered = rendered.replace("{{date}}", today)

    if "AI-hint:" not in rendered:
        if kind in ("bash", "bash-tool", "bash-verb", "automation-step", "drift-check"):
            rendered = f"#!/usr/bin/env bash\n# AI-hint: {desc_str}\n# AI-related: {rel_path}\n" + rendered
        elif kind in ("python-module", "python-tool", "python-test"):
            rendered = f"#!/usr/bin/env python3\n# AI-hint: {desc_str}\n# AI-related: {rel_path}\n" + rendered
        elif kind in ("adr", "markdown-doc", "roadmap", "roadmap-ws"):
            rendered = f"<!-- AI-hint: {desc_str} -->\n<!-- AI-related: {rel_path} -->\n" + rendered

    os.makedirs(os.path.dirname(os.path.abspath(filepath)), exist_ok=True)
    with open(filepath, "w", encoding="utf-8") as f:
        f.write(rendered)

    return filepath

def main():
    if len(sys.argv) < 3:
        print("Usage: mios-template-engine <kind> <target_filepath> [description]")
        print(f"Available kinds: {', '.join(list_templates())}")
        sys.exit(1)

    kind = sys.argv[1]
    target = sys.argv[2]
    desc = sys.argv[3] if len(sys.argv) > 3 else ""

    try:
        out = render_template(kind, target, desc)
        print(f"[mios-template-engine] Successfully rendered '{kind}' -> {out}")
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
