#!/usr/bin/env python3
# AI-hint: Thin shim delegating template rendering to the mios-new canonical generator, preserving the legacy <kind> <target_filepath> [description] contract.
# AI-related: /usr/libexec/mios/mios-new, /usr/share/mios/templates/
# AI-functions: main, _scaffold_via_mios_new

import sys
import os
import re
import shutil
import subprocess

def _scaffold_via_mios_new(kind, name):
    """Run mios-new and return the path it scaffolded, or None."""
    mios_new_bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "mios-new")
    res = subprocess.run(
        [sys.executable, mios_new_bin, kind, name],
        capture_output=True, text=True,
    )
    sys.stderr.write(res.stderr)
    if res.returncode != 0:
        sys.stdout.write(res.stdout)
        sys.exit(res.returncode)

    m = re.search(r"^Scaffolded new .+ at: (.+)$", res.stdout, re.MULTILINE)
    if not m:
        # mios-new printed the rendered body instead of writing a file
        # (no canonical destination for this kind) -- pass it through.
        sys.stdout.write(res.stdout)
        return None
    return m.group(1).strip()

def main():
    if len(sys.argv) < 3:
        print("Usage: mios-template-engine <kind> <target_filepath> [description]")
        sys.exit(1)

    kind = sys.argv[1]
    target = sys.argv[2]
    desc = sys.argv[3] if len(sys.argv) > 3 else ""

    # mios-new is name-addressed and picks its own canonical destination, so
    # derive the name from the requested path and relocate afterwards to keep
    # this entry point's documented <target_filepath> contract.
    name, _ = os.path.splitext(os.path.basename(target))

    produced = _scaffold_via_mios_new(kind, name)
    if produced is None:
        return

    target_abs = os.path.abspath(target)
    if os.path.abspath(produced) != target_abs:
        os.makedirs(os.path.dirname(target_abs), exist_ok=True)
        shutil.move(produced, target_abs)

    if desc:
        with open(target_abs, "r", encoding="utf-8") as f:
            body = f.read()
        if "{{description}}" in body:
            with open(target_abs, "w", encoding="utf-8", newline="\n") as f:
                f.write(body.replace("{{description}}", desc))

    print(f"[mios-template-engine] Successfully rendered '{kind}' -> {target_abs}")

if __name__ == "__main__":
    main()
