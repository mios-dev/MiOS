#!/usr/bin/env bash
# AI-hint: Value duplication reporter wrapper for MiOS resolved environment
# AI-related: /usr/share/mios/mios.toml, /usr/share/mios/reference/value-dup-report.tsv
# AI-functions: main
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="${MIOS_ROOT:-$(cd "${script_dir}/../../.." && pwd)}"
tools="${root}/tools"

if [[ -f "$tools/mios-dup-report" ]]; then
    python3 "$tools/mios-dup-report" "$@"
fi
