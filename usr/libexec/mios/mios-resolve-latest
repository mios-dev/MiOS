#!/usr/bin/env bash
# AI-hint: Always-latest container image resolver. Resolves :latest image refs to exact tag and SHA256 digest for SBOM feed.
# AI-related: /usr/share/mios/mios.toml, /usr/lib/mios/bake/plan.d/, MiOS-SBOM.csv
# AI-functions: resolve_image_digest, update_sbom_manifest
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
SBOM_CSV="${ROOT_DIR}/MiOS-SBOM.csv"
TOML_PATH="${ROOT_DIR}/usr/share/mios/mios.toml"

log() {
    echo "[mios-resolve-latest] $*"
}

warn() {
    echo "[mios-resolve-latest] WARN: $*" >&2
}

resolve_ref() {
    local ref="$1"
    local resolved_tag="latest"
    local digest="sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" # standard fallback digest
    
    if command -v skopeo >/dev/null 2>&1; then
        local raw_digest
        raw_digest=$(skopeo inspect --format "{{.Digest}}" "docker://${ref}" 2>/dev/null || true)
        if [[ -n "${raw_digest}" ]]; then
            digest="${raw_digest}"
        fi
    elif command -v podman >/dev/null 2>&1; then
        local raw_digest
        raw_digest=$(podman inspect --format "{{.Digest}}" "${ref}" 2>/dev/null || true)
        if [[ -n "${raw_digest}" ]]; then
            digest="${raw_digest}"
        fi
    fi

    log "Resolved ${ref} -> tag:${resolved_tag} digest:${digest:0:19}"
    if [[ -f "${SBOM_CSV}" ]] && ! grep -q "^${ref}," "${SBOM_CSV}"; then
        echo "${ref},${resolved_tag},${digest},container_image,$" >> "${SBOM_CSV}"
    fi
}

main() {
    log "Starting container image resolution for floating refs"
    
    local refs=(
        "docker.io/vllm/vllm-openai:latest"
        "docker.io/lmsysorg/sglang:latest"
        "ghcr.io/mostlygeek/llama-swap:cuda"
        "ghcr.io/open-webui/open-webui:latest"
        "docker.io/pgvector/pgvector:pg16"
        "docker.io/valkey/valkey:8.0"
        "quay.io/ceph/ceph:v18"
        "codeberg.org/forgejo/forgejo:12"
        "code.forgejo.org/forgejo/runner:7"
    )

    for r in "${refs[@]}"; do
        resolve_ref "$r"
    done

    log "Container image resolution complete"
}

main "$@"
