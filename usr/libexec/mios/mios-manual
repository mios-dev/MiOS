#!/usr/bin/env python3
# AI-hint: The generative documentation CLI. Builds the comment corpus ledger that makes "this comment's knowledge landed in a doc" a machine-checkable fact, and reports the census that drives the documentation ratchet. Only `prune` edits source, and only where the landing predicate proves the knowledge is already in a doc.
# AI-related: usr/lib/mios/mios_comments.py, usr/share/mios/reference/manual-corpus.tsv, automation/98-drift-checks.sh, docs/agy/doc-generative-documentation.md
# AI-functions: cmd_ledger, cmd_audit, cmd_coverage, cmd_harvest, cmd_prune, cmd_landing, cmd_render, landed, main
"""mios-manual -- corpus ledger and census for the MiOS documentation system.

Spec: docs/agy/doc-generative-documentation.md sections 3.4 and 5.

Subcommands:
  ledger   rebuild usr/share/mios/reference/manual-corpus.tsv from the tree
  audit    census as JSON (counts by class and reason)
  coverage the two ratchet numbers, for the gate and for humans
  harvest  move a comment's prose into a doc and record where it landed
  prune    delete a comment that provably landed (the only destructive path)
  landing  verify every pruned comment still lands in a doc
  render   splice derived content into MIOS-GEN marker interiors

`--root` selects the repo, and either layout resolves, so the same tools serve
mios.git and mios-bootstrap.git without being copied across (Law 15).

The ledger is the safety mechanism for the whole programme. Deletion of a
comment is only ever permitted once a ledger row proves its knowledge reached a
doc, so the landing columns must survive ordinary code churn: they are carried
forward BY CONTENT HASH, never recomputed. Moving a block within a file, or
reformatting the code around it, keeps its landing record.

Rows for blocks that no longer exist but were pruned are kept as tombstones --
that retention is what lets a gate prove, after the fact, that a comment which
is gone did land somewhere first.
"""
from __future__ import annotations

import argparse
import collections
import json
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_ROOT_DEFAULT = os.path.abspath(os.path.join(_HERE, "..", "..", ".."))
sys.path.insert(0, os.path.join(_ROOT_DEFAULT, "usr", "lib", "mios"))

try:
    import tomllib
except ImportError:  # pragma: no cover
    tomllib = None

import mios_comments as mc  # noqa: E402

LEDGER_REL = "usr/share/mios/reference/manual-corpus.tsv"

COLUMNS = ["path", "start_line", "end_line", "lines", "words", "sha12", "class",
           "reason", "as", "stale", "landed_doc", "landed_anchor", "landed_words",
           "pruned"]

# Which files the census covers is defined once, in mios_comments.
SCAN_EXT = mc.SCAN_EXT


def _ssot_path(root: str) -> str:
    """The SSOT for a repo root, in either repo's layout.

    mios.git keeps it at usr/share/mios/mios.toml (it IS the deployed /usr);
    mios-bootstrap.git keeps its overlay at the root. Resolving both here is
    what lets one set of doc tools serve both repos, instead of the tools being
    copied across -- which Law 15 forbids.
    """
    for rel in ("usr/share/mios/mios.toml", "mios.toml"):
        cand = os.path.join(root, rel.replace("/", os.sep))
        if os.path.isfile(cand):
            return cand
    return os.path.join(root, "usr", "share", "mios", "mios.toml")


def _policy(root: str) -> mc.Policy:
    if tomllib is None:
        return mc.Policy()
    with open(_ssot_path(root), "rb") as fh:
        return mc.Policy.from_toml(tomllib.load(fh))


def _iter_blocks(root: str, policy: mc.Policy, refindex=None):
    for rel, full in mc.iter_source_files(root):
        try:
            blocks = mc.lex(full)
        except Exception:
            continue
        for b in blocks:
            b = mc.Block(**{**b.__dict__, "path": rel})
            yield b, mc.classify(b, policy, refindex)


def _read_ledger(path: str) -> dict[str, dict]:
    """Existing rows keyed by sha12, so landing survives code churn."""
    out: dict[str, dict] = {}
    if not os.path.isfile(path):
        return out
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) != len(COLUMNS):
                continue
            row = dict(zip(COLUMNS, parts))
            out[row["sha12"]] = row
    return out


def _refuse_if_degraded() -> int:
    """The census must be the same artifact everywhere, or it is not a projection.

    A file the Python lexer could not tokenize or parse falls back to the regex
    lexer, which the module itself documents as miscounting -- and whether that
    happens depends on the INTERPRETER, not the file, so the same tree yields
    different ledgers on different machines. Refusing is the honest outcome.
    """
    if not mc.DEGRADED:
        return 0
    print("cannot build a reproducible census: these files did not parse on "
          f"python{sys.version_info.major}.{sys.version_info.minor}, so their "
          "comments were counted by the fallback lexer:", file=sys.stderr)
    for rel in sorted(set(mc.DEGRADED)):
        print(f"  {rel}", file=sys.stderr)
    print("  (the repo's sources need a newer Python; upgrade rather than "
          "committing the degraded ledger)", file=sys.stderr)
    return 1


def cmd_ledger(args) -> int:
    root = args.root
    policy = _policy(root)
    mc.DEGRADED.clear()
    dest = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    prior = _read_ledger(dest)

    rows = []
    seen: set[str] = set()
    for b, v in _iter_blocks(root, policy):
        old = prior.get(b.sha12, {})
        seen.add(b.sha12)
        rows.append({
            "path": b.path, "start_line": str(b.start_line), "end_line": str(b.end_line),
            "lines": str(b.lines), "words": str(b.words), "sha12": b.sha12,
            "class": v.cls, "reason": v.reason, "as": v.as_,
            "stale": "1" if v.stale else "0",
            # Carried forward by hash, never recomputed.
            "landed_doc": old.get("landed_doc", ""),
            "landed_anchor": old.get("landed_anchor", ""),
            "landed_words": old.get("landed_words", ""),
            "pruned": old.get("pruned", "0"),
        })

    # Tombstones: a pruned block is gone from the tree but its landing proof
    # must outlive it, otherwise nothing can show the deletion was safe.
    tombstones = [r for sha, r in prior.items()
                  if sha not in seen and r.get("pruned") == "1"]
    rows.extend(tombstones)
    rows.sort(key=lambda r: (r["path"], int(r["start_line"] or 0)))

    body = ["# " + "\t".join(COLUMNS)]
    body += ["\t".join(r[c] for c in COLUMNS) for r in rows]
    text = "\n".join(body) + "\n"

    if _refuse_if_degraded():
        return 1

    if args.check:
        current = ""
        if os.path.isfile(dest):
            with open(dest, encoding="utf-8", newline="") as fh:
                current = fh.read()
        if current.replace("\r\n", "\n") != text:
            print(f"{LEDGER_REL} is stale -- run `mios-manual ledger --write`",
                  file=sys.stderr)
            return 1
        print(f"{LEDGER_REL} up to date ({len(rows)} rows)")
        return 0

    os.makedirs(os.path.dirname(dest), exist_ok=True)
    with open(dest, "w", encoding="utf-8", newline="\n") as fh:
        fh.write(text)
    print(f"wrote {LEDGER_REL}: {len(rows)} rows "
          f"({len(tombstones)} tombstones carried)")
    return 0


def landed(row: dict, root: str, policy: mc.Policy) -> bool:
    """True when this row's knowledge is provably in a doc.

    The predicate `prune` and the landing gate both use. Deliberately strict:
    the doc must exist, must carry the block's own content hash as an anchor,
    and the passage must retain most of the words. Anything weaker would let a
    one-line stub authorise deleting a 90-line design note.
    """
    doc = row.get("landed_doc") or ""
    if not doc:
        return False
    p = os.path.join(root, doc.replace("/", os.sep))
    if not os.path.isfile(p):
        return False
    try:
        with open(p, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return False
    marker = f"mios-src:{row['sha12']}"
    if marker not in text:
        return False
    try:
        want = int(row.get("words") or 0)
        got = int(row.get("landed_words") or 0)
    except ValueError:
        return False
    return got >= policy.landing_min_word_ratio * want


def _write_ledger(root: str, rows: list[dict]) -> None:
    dest = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    rows = sorted(rows, key=lambda r: (r["path"], int(r["start_line"] or 0)))
    body = ["# " + "\t".join(COLUMNS)]
    body += ["\t".join(r[c] for c in COLUMNS) for r in rows]
    with open(dest, "w", encoding="utf-8", newline="\n") as fh:
        fh.write("\n".join(body) + "\n")


def _slug(text: str, limit: int = 60) -> str:
    """A short human title for a harvested passage.

    Source comments often open with banner decoration (`--- section ---`) or a
    bullet; carrying that into a Markdown heading reads as noise, so strip the
    ornament and title the passage by its first real words.
    """
    import re as _re
    first = " ".join(text.split())
    first = _re.sub(r"^[\s\-=*#/_.:|>+]+", "", first)
    first = _re.sub(r"[\s\-=*_]+$", "", first)
    # A leading "key:" label is a better title on its own than a truncated line.
    label = _re.match(r"^([A-Za-z][\w ./-]{2,40}?):\s", first)
    if label:
        return label.group(1).strip()
    if len(first) > limit:
        first = first[:limit].rsplit(" ", 1)[0].rstrip(" ,;:") + "..."
    return first or "harvested note"


def _passage(block, rel_src: str) -> str:
    """The doc form of a source comment.

    Carries the mios-src anchor that landed() looks for, so the doc itself is
    the proof -- not a promise recorded elsewhere.
    """
    return (f"### {_slug(block.text)}\n\n"
            f"{block.text.strip()}\n\n"
            f"<!-- mios-src:{block.sha12} "
            f"from {rel_src}:{block.start_line}-{block.end_line} -->\n")


def cmd_harvest(args) -> int:
    """Move a source comment's PROSE into a doc, and record where it landed.

    Harvest never edits source. It writes the passage, stamps the anchor and
    fills the ledger's landing columns; `prune` is the only thing that removes
    the original, and only once landed() proves this step happened.
    """
    root = args.root
    policy = _policy(root)
    src_rel = args.path.replace(os.sep, "/")
    dest_rel = args.to.replace(os.sep, "/")
    dest_abs = os.path.join(root, dest_rel.replace("/", os.sep))

    wanted = [b for b, v in _iter_blocks(root, policy)
              if b.path == src_rel and v.cls == "MIGRATE"
              and (not args.block or b.sha12.startswith(args.block))]
    if not wanted:
        print(f"no MIGRATE block in {src_rel}"
              + (f" matching {args.block}" if args.block else ""), file=sys.stderr)
        return 1

    ledger_path = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    rows = _read_ledger(ledger_path)
    if not rows:
        print(f"{LEDGER_REL} is empty -- run `mios-manual ledger --write` first",
              file=sys.stderr)
        return 1

    existing = ""
    if os.path.isfile(dest_abs):
        with open(dest_abs, encoding="utf-8") as fh:
            existing = fh.read()

    added, skipped = [], []
    chunks = []
    for b in wanted:
        if f"mios-src:{b.sha12}" in existing:
            skipped.append(b.sha12)
            continue
        chunks.append(_passage(b, src_rel))
        added.append(b)

    if args.dry_run:
        for b in added:
            print(f"would harvest {b.sha12} ({b.words} words) "
                  f"{src_rel}:{b.start_line}-{b.end_line} -> {dest_rel}")
        for sha in skipped:
            print(f"already landed: {sha}")
        return 0

    if chunks:
        os.makedirs(os.path.dirname(dest_abs), exist_ok=True)
        header = ""
        if not existing:
            header = (f"<!-- AI-hint: Prose harvested out of source comments by "
                      f"`mios-manual harvest`; each passage carries the mios-src anchor "
                      f"that proves which comment it came from. -->\n\n"
                      f"# Harvested notes\n\n")
        with open(dest_abs, "a", encoding="utf-8", newline="\n") as fh:
            if header:
                fh.write(header)
            elif not existing.endswith("\n\n"):
                fh.write("\n")
            fh.write("\n".join(chunks))

    for b in added:
        row = rows.get(b.sha12)
        if row is None:
            continue
        row["landed_doc"] = dest_rel
        row["landed_anchor"] = f"mios-src:{b.sha12}"
        row["landed_words"] = str(b.words)
    _write_ledger(root, list(rows.values()))

    for b in added:
        print(f"harvested {b.sha12} ({b.words} words) -> {dest_rel}")
    for sha in skipped:
        print(f"already landed: {sha}")
    return 0


def cmd_prune(args) -> int:
    """Delete a source comment, but ONLY where landed() proves it is in a doc.

    This is the only destructive path in the programme, so the predicate is
    checked per block immediately before the lines are removed.
    """
    root = args.root
    policy = _policy(root)
    src_rel = args.path.replace(os.sep, "/")
    src_abs = os.path.join(root, src_rel.replace("/", os.sep))
    ledger_path = os.path.join(root, LEDGER_REL.replace("/", os.sep))
    rows = _read_ledger(ledger_path)

    targets = []
    for b, v in _iter_blocks(root, policy):
        if b.path != src_rel or v.cls != "MIGRATE":
            continue
        if args.block and not b.sha12.startswith(args.block):
            continue
        row = rows.get(b.sha12)
        if row is None:
            print(f"refusing {b.sha12}: no ledger row", file=sys.stderr)
            continue
        if not landed(row, root, policy):
            print(f"refusing {b.sha12}: not landed in a doc "
                  f"(harvest it first)", file=sys.stderr)
            continue
        targets.append((b, row))

    if not targets:
        print("nothing prunable (harvest first, then prune)", file=sys.stderr)
        return 1

    if args.dry_run:
        for b, _ in targets:
            print(f"would prune {src_rel}:{b.start_line}-{b.end_line} ({b.sha12})")
        return 0

    with open(src_abs, encoding="utf-8", newline="") as fh:
        lines = fh.readlines()
    # Highest line first, so earlier offsets stay valid as lines are removed.
    for b, row in sorted(targets, key=lambda t: t[0].start_line, reverse=True):
        del lines[b.start_line - 1:b.end_line]
        row["pruned"] = "1"
    with open(src_abs, "w", encoding="utf-8", newline="") as fh:
        fh.writelines(lines)

    _write_ledger(root, list(rows.values()))
    for b, _ in targets:
        print(f"pruned {src_rel}:{b.start_line}-{b.end_line} ({b.sha12})")
    return 0


def cmd_landing(args) -> int:
    """Every pruned comment must still be provably present in a doc.

    A tombstone whose doc passage was later deleted would mean a comment was
    removed and its knowledge then silently lost -- exactly what the ledger
    exists to make impossible. This is the gate for that.
    """
    root = args.root
    policy = _policy(root)
    rows = _read_ledger(os.path.join(root, LEDGER_REL.replace("/", os.sep)))
    broken = [r for r in rows.values()
              if r.get("pruned") == "1" and not landed(r, root, policy)]
    for r in broken:
        print(f"pruned block {r['sha12']} ({r['path']}) no longer lands in "
              f"{r.get('landed_doc') or '<unset>'}", file=sys.stderr)
    if broken:
        return 1
    pruned_n = sum(1 for r in rows.values() if r.get("pruned") == "1")
    print(f"landing proofs intact ({pruned_n} pruned block(s) still documented)")
    return 0


def cmd_audit(args) -> int:
    root = args.root
    policy = _policy(root)
    refindex = mc.RefIndex.build(root) if args.stale else None
    by_class = collections.Counter()
    by_reason = collections.Counter()
    words = collections.Counter()
    stale_n = 0
    total = 0
    for b, v in _iter_blocks(root, policy, refindex):
        total += 1
        by_class[v.cls] += 1
        by_reason[v.reason] += 1
        words[v.cls] += b.words
        if v.stale:
            stale_n += 1
    report = {
        "blocks": total,
        "by_class": dict(by_class.most_common()),
        "by_reason": dict(by_reason.most_common()),
        "words_by_class": dict(words.most_common()),
        "stale": stale_n if refindex else None,
    }
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"comment blocks: {total}")
        for k, v in by_class.most_common():
            print(f"  {k:16s} {v:6d}  ({words[k]:,} words)")
        if refindex:
            print(f"  stale refs      {stale_n:6d}")
    return 0


FLOOR_REL = "usr/share/mios/reference/doc-ratchet-floor.tsv"
_RATCHET_KEYS = ("max_unmigrated_narrative", "max_overlong_hints")


def read_floor(root: str) -> dict[str, int]:
    """The lowest ceiling ever recorded, per ratchet key."""
    out: dict[str, int] = {}
    path = os.path.join(root, FLOOR_REL.replace("/", os.sep))
    if not os.path.isfile(path):
        return out
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) == 2 and parts[1].strip().isdigit():
                out[parts[0].strip()] = int(parts[1])
    return out


def cmd_coverage(args) -> int:
    """The two ratchet numbers, so the gate and a human read the same figures."""
    root = args.root
    policy = _policy(root)
    narrative = hints = 0
    for _b, v in _iter_blocks(root, policy):
        if v.cls == "MIGRATE":
            narrative += 1
        elif v.cls == "MIGRATE_HEADER":
            hints += 1
    out = {"unmigrated_narrative": narrative, "overlong_hints": hints}

    if getattr(args, "write_floor", False):
        # min(recorded, current ceiling): the mark only ever falls, so a ceiling
        # that was lowered once can never be quietly raised back to a prior
        # value even if history is rewritten or the HEAD comparison is skipped.
        with open(_ssot_path(root), "rb") as fh:
            docs = (tomllib.load(fh).get("docs", {}) or {})
        prior = read_floor(root)
        rows = []
        for k in _RATCHET_KEYS:
            if k not in docs:
                continue
            rows.append((k, min(int(docs[k]), prior.get(k, int(docs[k])))))
        dest = os.path.join(root, FLOOR_REL.replace("/", os.sep))
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "w", encoding="utf-8", newline="\n") as fh:
            fh.write("# ratchet_key\tlowest_ceiling_ever_recorded\n")
            for k, v in rows:
                fh.write(f"{k}\t{v}\n")
        print(f"wrote {FLOOR_REL}: " + ", ".join(f"{k}={v}" for k, v in rows))
        return 0

    if args.json:
        print(json.dumps(out))
    else:
        print(f"unmigrated narrative blocks: {narrative}")
        print(f"over-cap AI-hint headers:    {hints}")
    return 0


