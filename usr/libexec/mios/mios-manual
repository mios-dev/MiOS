MARK_OPEN = "<!-- MIOS-GEN:{id} -->"
MARK_CLOSE = "<!-- /MIOS-GEN:{id} -->"
_MARK_RE = None


def _marker_re():
    global _MARK_RE
    if _MARK_RE is None:
        import re
        _MARK_RE = re.compile(
            r"(?P<open><!--\s*MIOS-GEN:(?P<id>[^\s>]+)\s*-->)"
            r"(?P<body>.*?)"
            r"(?P<close><!--\s*/MIOS-GEN:(?P=id)\s*-->)",
            re.S)
    return _MARK_RE


class DeriverError(ValueError):
    """A deriver was asked for something the SSOT does not define.

    Unknown deriver KINDS already failed the run; unknown ARGS silently fell
    back to rendering everything, so `ports:ai` quietly emitted the full table
    instead of saying the category does not exist.
    """


# The root the derivers read from. Their signature is (ssot, arg), so the
# render pass parks it here rather than threading it through every one.
_DERIVE_ROOT = [_ROOT_DEFAULT]


def _tracked(root: str, pattern: str = "") -> list[str]:
    """Repo-relative paths of tracked files, sorted.

    Tracked rather than walked, for the same reason the census is: an untracked
    scratch file must not change what the gate checks.
    """
    import subprocess
    args = ["git", "ls-files", "-z"] + ([pattern] if pattern else [])
    try:
        out = subprocess.run(args, cwd=root, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, check=True).stdout.decode("utf-8")
        return sorted(r for r in out.split("\0") if r)
    except Exception:
        return []


def _tracked_markdown(root: str) -> list[str]:
    """Absolute paths of every git-tracked .md file, sorted."""
    rels = _tracked(root, "*.md")
    if not rels:
        rels = []
        for dp, dn, fns in os.walk(os.path.join(root, "usr", "share", "doc", "mios")):
            dn[:] = [d for d in dn if d != ".git"]
            rels += [os.path.relpath(os.path.join(dp, f), root).replace(os.sep, "/")
                     for f in fns if f.endswith(".md")]
    return sorted(os.path.join(root, r.replace("/", os.sep)) for r in rels)


def _derive_ports(ssot: dict, arg: str) -> str:
    cats = (ssot.get("ports", {}) or {}).get("categories", {}) or {}
    ports = ssot.get("ports", {}) or {}
    if arg and arg not in cats:
        raise DeriverError(f"ports: no such category '{arg}' in [ports.categories]")
    names = [arg] if arg else sorted(cats)
    out = ["| Category | Service | Port |", "|---|---|---|"]
    for cname in names:
        cat = cats[cname] or {}
        for m in cat.get("members", []) or []:
            out.append(f"| {cname} | {m} | {ports.get(m, '?')} |")
        for pin, val in (cat.get("pinned", {}) or {}).items():
            out.append(f"| {cname} | {pin} (pinned) | {val} |")
    out.append("")
    out.append("<!-- derived from usr/share/mios/mios.toml [ports.categories] -->")
    return "\n".join(out)


def _derive_laws(ssot: dict, arg: str) -> str:
    laws = (ssot.get("laws", {}) or {}).get("laws", []) or []
    out = ["| # | Law | Applies to | Enforced by |", "|---|---|---|---|"]
    for l in laws:
        out.append(f"| {l.get('id')} | {l.get('slug')} | {l.get('applies_to')} "
                   f"| `{l.get('enforced_by')}` |")
    out.append("")
    out.append("<!-- derived from usr/share/mios/mios.toml [laws].laws -->")
    return "\n".join(out)


def _derive_root_exceptions(ssot: dict, arg: str) -> str:
    """Law 6's sanctioned root Quadlets, so the exception list is never retyped."""
    sec = (ssot.get("security", {}) or {}).get("privileged_quadlets", {}) or {}
    rows = sec.get("root", []) or []
    out = ["| Quadlet | Runs as root because |", "|---|---|"]
    for entry in rows:
        if isinstance(entry, dict):
            out.append(f"| `{entry.get('unit', '?')}` | {entry.get('why', '')} |")
        else:
            out.append(f"| `{entry}` | see `[security.privileged_quadlets]` |")
    out.append("")
    out.append("<!-- derived from usr/share/mios/mios.toml "
               "[security.privileged_quadlets].root -->")
    return "\n".join(out)


def _derive_pipeline(ssot: dict, arg: str) -> str:
    """The numbered build phases -- the doc that goes stale fastest by hand."""
    phases = ((ssot.get("build", {}) or {}).get("phases", {}) or {}).get("list", []) or []
    out = ["| # | Phase | Script | Fatal | Applies |", "|---|---|---|---|---|"]
    for p in phases:
        out.append(f"| {p.get('ordinal', '?')} | {p.get('name', '')} "
                   f"| `{p.get('script', '')}` "
                   f"| {'yes' if p.get('fatal') else 'no'} "
                   f"| {p.get('apply_class', '')} |")
    out.append("")
    out.append(f"<!-- derived from usr/share/mios/mios.toml [build.phases].list "
               f"({len(phases)} phases) -->")
    return "\n".join(out)


def _derive_verbs(ssot: dict, arg: str) -> str:
    """The `mios <verb>` surface, straight from [verbs.*]."""
    verbs = ssot.get("verbs", {}) or {}
    if arg and arg not in verbs:
        raise DeriverError(f"verbs: no such verb '{arg}' in [verbs]")
    names = [arg] if arg else sorted(verbs)
    out = ["| Verb | Surface | Description |", "|---|---|---|"]
    for name in names:
        v = verbs.get(name) or {}
        if not isinstance(v, dict):
            continue
        out.append(f"| `mios {name}` | {v.get('surface', '')} "
                   f"| {v.get('description', '')} |")
    out.append("")
    out.append(f"<!-- derived from usr/share/mios/mios.toml [verbs] "
               f"({len(names)} verb(s)) -->")
    return "\n".join(out)


def _derive_boilerplate(ssot: dict, arg: str) -> str:
    """The framing paragraph every MiOS doc opens with.

    It was hand-copied into dozens of files, so the copies drifted. One SSOT
    string, spliced wherever it is wanted.
    """
    bp = (ssot.get("docs", {}) or {}).get("boilerplate", {}) or {}
    key = arg or "what-mios-is"
    text = bp.get(key)
    if not text:
        raise DeriverError(
            f"boilerplate: no '{key}' in [docs.boilerplate] "
            f"(have: {', '.join(sorted(bp)) or 'none'})")
    return text.strip() + "\n\n<!-- derived from usr/share/mios/mios.toml " \
                          f"[docs.boilerplate].{key} -->"


def _hint_index(root: str, pattern: str) -> list[tuple[str, str]]:
    """(path, AI-hint) for every tracked file matching a glob.

    The hint header is already the one-line description of what a file is for,
    written next to the file and kept honest by check_hint_coverage. Reading it
    back out is how a documentation index stops being a hand-kept list.
    """
    import fnmatch
    tagmod = mc.load_ai_tag(root)
    if tagmod is None:
        raise DeriverError("index: cannot load mios-ai-tag to read AI-hints")
    out = []
    for rel in _tracked(root):
        if not fnmatch.fnmatch(rel, pattern):
            continue
        full = os.path.join(root, rel.replace("/", os.sep))
        try:
            with open(full, encoding="utf-8", errors="replace") as fh:
                head = fh.read(4000)
        except OSError:
            continue
        hint = tagmod.existing_hint(head)
        if hint:
            out.append((rel, hint))
    return sorted(out)


def _derive_index(ssot: dict, arg: str) -> str:
    if not arg:
        raise DeriverError("index: needs a glob, e.g. index:usr/libexec/mios/mios-*")
    rows = _hint_index(_DERIVE_ROOT[0], arg)
    if not rows:
        raise DeriverError(f"index: no tracked file with an AI-hint matches '{arg}'")
    out = ["| File | What it is |", "|---|---|"]
    for rel, hint in rows:
        one = " ".join(hint.split())
        if len(one) > 200:
            one = one[:200].rsplit(" ", 1)[0] + "..."
        out.append(f"| `{rel}` | {one} |")
    out.append("")
    out.append(f"<!-- derived from the AI-hint headers of {len(rows)} file(s) "
               f"matching {arg} -->")
    return "\n".join(out)


def _derive_related(ssot: dict, arg: str) -> str:
    """The AI-related line of one file, as links."""
    if not arg:
        raise DeriverError("related: needs a path, e.g. related:usr/libexec/mios/mios-manual")
    full = os.path.join(_DERIVE_ROOT[0], arg.replace("/", os.sep))
    if not os.path.isfile(full):
        raise DeriverError(f"related: no such file '{arg}'")
    import re as _re
    with open(full, encoding="utf-8", errors="replace") as fh:
        head = fh.read(4000)
    m = _re.search(r"AI-related:\s*(.+?)\s*(?:-->)?\s*$", head, _re.I | _re.M)
    if not m:
        raise DeriverError(f"related: '{arg}' carries no AI-related header")
    items = [i.strip() for i in m.group(1).split(",") if i.strip()]
    out = [f"- `{i}`" for i in items]
    out.append("")
    out.append(f"<!-- derived from the AI-related header of {arg} -->")
    return "\n".join(out)


DERIVERS = {
    "ports": _derive_ports,
    "laws": _derive_laws,
    "root-exceptions": _derive_root_exceptions,
    "pipeline": _derive_pipeline,
    "verbs": _derive_verbs,
    "boilerplate": _derive_boilerplate,
    "index": _derive_index,
    "related": _derive_related,
}


def _derive(gen_id: str, ssot: dict) -> str | None:
    kind, _, arg = gen_id.partition(":")
    fn = DERIVERS.get(kind)
    return None if fn is None else fn(ssot, arg)


def cmd_render(args) -> int:
    """Splice derived content into marker pairs. Writes NOWHERE else.

    The whole safety story of the doc model is that regeneration cannot destroy
    hand-written prose. That holds only because this function's sole write is
    replacing the interior of a matched MIOS-GEN pair -- there is deliberately no
    code path that emits a whole file, so an authored paragraph outside a marker
    is untouchable even if a deriver misbehaves.
    """
    root = args.root
    if tomllib is None:
        print("tomllib unavailable", file=sys.stderr)
        return 1
    with open(_ssot_path(root), "rb") as fh:
        ssot = tomllib.load(fh)
    _DERIVE_ROOT[0] = root

    # Scope: every TRACKED Markdown file, not just usr/share/doc/mios -- a
    # marker in README.md or docs/ was previously never rendered or checked, so
    # a stale derived table could ship from there. Note this cannot reuse
    # mios_comments.iter_source_files: that filters by SCAN_EXT, which
    # deliberately excludes .md, and using it here silently emptied the scope.
    # Only files that actually contain a marker are opened for writing.
    targets = _tracked_markdown(root)

    rx = _marker_re()
    changed, spliced, unknown, bad_args = [], 0, set(), []
    for path in sorted(targets):
        try:
            with open(path, encoding="utf-8", newline="") as fh:
                src = fh.read()
        except OSError:
            continue
        if "MIOS-GEN:" not in src:
            continue
        rel_for_msg = os.path.relpath(path, root).replace(os.sep, "/")

        def repl(m):
            nonlocal spliced
            gid = m.group("id")
            try:
                body = _derive(gid, ssot)
            except DeriverError as exc:
                bad_args.append(f"{rel_for_msg}: {exc}")
                return m.group(0)
            if body is None:
                unknown.add(gid)
                return m.group(0)
            spliced += 1
            return f"{m.group('open')}\n{body}\n{m.group('close')}"

        new = rx.sub(repl, src)
        if new != src:
            changed.append(os.path.relpath(path, root).replace(os.sep, "/"))
            if not args.check:
                with open(path, "w", encoding="utf-8", newline="\n") as fh:
                    fh.write(new)

    if bad_args:
        print("MIOS-GEN markers asking for values the SSOT does not define:",
              file=sys.stderr)
        for msg in bad_args:
            print(f"  {msg}", file=sys.stderr)
        return 1
    if unknown:
        print("unknown MIOS-GEN ids (no deriver): " + ", ".join(sorted(unknown)),
              file=sys.stderr)
        return 1
    if args.check:
        if changed:
            print("derived sections are stale -- run `mios-manual render`:\n  "
                  + "\n  ".join(changed), file=sys.stderr)
            return 1
        print(f"derived sections up to date ({spliced} markers)")
        return 0
    print(f"rendered {spliced} marker(s); {len(changed)} file(s) updated")
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="mios-manual", description=__doc__.splitlines()[0])
    ap.add_argument("--root", default=os.environ.get("MIOS_ROOT") or _ROOT_DEFAULT)
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("ledger", help="rebuild or verify the corpus ledger")
    p.add_argument("--write", action="store_true")
    p.add_argument("--check", action="store_true")
    p.set_defaults(fn=cmd_ledger)

    p = sub.add_parser("audit", help="census of the comment corpus")
    p.add_argument("--json", action="store_true")
    p.add_argument("--stale", action="store_true", help="also resolve references (slow)")
    p.set_defaults(fn=cmd_audit)

    p = sub.add_parser("coverage", help="the two ratchet numbers")
    p.add_argument("--json", action="store_true")
    p.add_argument("--write-floor", action="store_true",
                   help="record the lowest ceiling ever seen")
    p.set_defaults(fn=cmd_coverage)

    p = sub.add_parser("harvest", help="move a source comment's prose into a doc")
    p.add_argument("--path", required=True, help="source file, repo-relative")
    p.add_argument("--to", required=True, help="destination doc, repo-relative")
    p.add_argument("--block", help="only this sha12 (prefix ok)")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_harvest)

    p = sub.add_parser("prune", help="delete a comment that provably landed in a doc")
    p.add_argument("--path", required=True, help="source file, repo-relative")
    p.add_argument("--block", help="only this sha12 (prefix ok)")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_prune)

    p = sub.add_parser("landing", help="verify every pruned block still lands in a doc")
    p.add_argument("--check", action="store_true")
    p.set_defaults(fn=cmd_landing)

    p = sub.add_parser("render", help="splice derived sections into MIOS-GEN markers")
    p.add_argument("--check", action="store_true",
                   help="fail if any derived section is stale; write nothing")
    p.set_defaults(fn=cmd_render)

    args = ap.parse_args(argv)
    if args.cmd == "ledger" and not (args.write or args.check):
        args.write = True
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
