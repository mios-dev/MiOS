#!/usr/bin/env bash
# AI-hint: Executes the mios-cpu-isolate.service to parse isolcpus= kernel parameters and migrate all user-space processes onto non-isolated host cores via taskset to ensure deterministic performance.
# AI-related: /usr/lib/mios/paths.sh, mios-cpu-isolate, mios-cpu-isolate.service, multi-user.target
# AI-functions: _log, expand
set -euo pipefail
source /usr/lib/mios/paths.sh

_log()  { logger -t mios-cpu-isolate "$*" 2>/dev/null || true; echo "[cpu-isolate] $*" >&2; }

ISOL=""
for tok in $(< /proc/cmdline); do
    case "$tok" in
        isolcpus=*)
            v="${tok#isolcpus=}"
            ISOL=${v##*,}
            ;;
    esac
done

if [[ -z "$ISOL" ]]; then
    _log "no isolcpus karg present; nothing to do"
    exit 0
fi

TOTAL=$(nproc)
LAST=$((TOTAL - 1))
expand() {
    local spec="$1" out=""
    IFS=',' read -ra parts <<<"$spec"
    for p in "${parts[@]}"; do
        if [[ "$p" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            for i in $(seq "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"); do out+="$i "; done
        elif [[ "$p" =~ ^[0-9]+$ ]]; then
            out+="$p "
        fi
    done
    echo "$out"
}
ISOL_SET=$(expand "$ISOL")
HOST_SET=""
for i in $(seq 0 "$LAST"); do
    case " $ISOL_SET " in
        *" $i "*) ;;
        *)        HOST_SET+="$i," ;;
    esac
done
HOST_SET="${HOST_SET%,}"

if [[ -z "$HOST_SET" ]]; then
    _log "ALL CPUs are isolated -- refusing (would orphan userspace)"
    exit 1
fi

_log "isolated: $ISOL  host: $HOST_SET  (total=$TOTAL)"

moved=0; skipped=0; failed=0
for pid in $(ps -eo pid --no-headers); do
    [[ -d "/proc/$pid" ]] || continue
    ppid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null) || continue
    if [[ "$ppid" == 2 || "$pid" == 2 ]]; then
        skipped=$((skipped + 1))
        continue
    fi
    if taskset -cpa "$HOST_SET" "$pid" >/dev/null 2>&1; then
        moved=$((moved + 1))
    else
        failed=$((failed + 1))
    fi
done

_log "moved=$moved kernel-skipped=$skipped failed=$failed"

install -d -m 0755 /run/mios
{
    echo "Timestamp=$"
    echo "Isolated=$ISOL"
    echo "Host_range=$HOST_SET"
    echo "Moved=$moved"
    echo "Kernel_threads_skipped=$skipped"
    echo "Failed=$failed"
} > /run/mios/cpu-isolate.status
exit 0
