#!/usr/bin/env bash
# AI-hint: Generates clevis LUKS TPM2 binding configuration from mios.toml [security.luks] SSOT.
set -euo pipefail

TOML="${1:-/usr/share/mios/mios.toml}"

# Every read below is a HARD error. The previous revision ended each value with
# `2>/dev/null || echo "False"`, which turned a missing [security.luks] table, an
# unparseable mios.toml, an absent mios.toml and even a missing python3 into a
# successful run that printed plausible-looking defaults -- so the projection
# could not be distinguished from a total SSOT read failure, and check_clevis_luks
# stayed green through all four. A generator that cannot read the SSOT must fail.
_die() {
    printf 'mios-clevis-luks-gen: %s\n' "$*" >&2
    exit 1
}

command -v python3 >/dev/null 2>&1 \
    || _die "python3 is required to read the SSOT and is not installed"
[[ -f "$TOML" ]] \
    || _die "SSOT is not a readable regular file: ${TOML}"

RENDERED="$(MIOS_CLEVIS_TOML="$TOML" python3 - <<'PY'
import os
import sys
import tomllib

path = os.environ["MIOS_CLEVIS_TOML"]


def fail(msg):
    sys.stderr.write("mios-clevis-luks-gen: %s\n" % msg)
    raise SystemExit(1)


try:
    with open(path, "rb") as fh:
        data = tomllib.load(fh)
except OSError as exc:
    fail("cannot read SSOT %s: %s" % (path, exc))
except tomllib.TOMLDecodeError as exc:
    fail("SSOT %s is not valid TOML: %s" % (path, exc))

security = data.get("security")
if not isinstance(security, dict):
    fail("[security] table missing from %s" % path)
luks = security.get("luks")
if not isinstance(luks, dict):
    fail("[security.luks] table missing from %s" % path)

missing = [k for k in ("enabled", "pin", "pcrs") if k not in luks]
if missing:
    fail("[security.luks] is missing required key(s): %s" % ", ".join(missing))

enabled = luks["enabled"]
if not isinstance(enabled, bool):
    fail("[security.luks].enabled must be a TOML boolean, got %r" % (enabled,))

# The pin names the clevis unlock backend; anything outside this set would be
# written verbatim into a binding config that clevis cannot honour.
PINS = ("tpm2", "tang", "sss")
pin = luks["pin"]
if not isinstance(pin, str) or pin not in PINS:
    fail("[security.luks].pin must be one of %s, got %r" % (", ".join(PINS), pin))

raw_pcrs = luks["pcrs"]
if isinstance(raw_pcrs, bool):
    fail("[security.luks].pcrs must be a PCR list, got a boolean")
if isinstance(raw_pcrs, int):
    parts = [raw_pcrs]
elif isinstance(raw_pcrs, str):
    parts = [p.strip() for p in raw_pcrs.split(",")]
elif isinstance(raw_pcrs, list):
    parts = raw_pcrs
else:
    fail("[security.luks].pcrs must be an int, a comma-separated string or a "
         "list of ints, got %r" % (raw_pcrs,))

pcrs = []
for part in parts:
    if isinstance(part, bool) or not isinstance(part, (int, str)):
        fail("[security.luks].pcrs contains a non-PCR entry: %r" % (part,))
    text = str(part).strip()
    if not text.isdigit():
        fail("[security.luks].pcrs entry is not a PCR index: %r" % (part,))
    index = int(text)
    if not 0 <= index <= 23:
        fail("[security.luks].pcrs entry %d is outside the TPM2 range 0-23" % index)
    pcrs.append(str(index))
if not pcrs:
    fail("[security.luks].pcrs is empty; a TPM2 binding needs at least one PCR")

sys.stdout.write(
    "# Clevis LUKS binding -- projected from usr/share/mios/mios.toml [security.luks]\n"
    "# Generated by usr/libexec/mios/mios-clevis-luks-gen; do not edit by hand.\n"
    'CLEVIS_LUKS_ENABLED="%s"\n'
    'CLEVIS_PIN="%s"\n'
    'CLEVIS_PCRS="%s"\n' % (str(enabled).lower(), pin, ",".join(pcrs))
)
PY
)" || exit 1

printf '%s\n' "$RENDERED"
