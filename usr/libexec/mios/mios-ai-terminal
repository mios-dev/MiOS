#!/bin/bash
# AI-hint: Mobile text frontend for the existing MiOS AI CLI; reads prompts literally and delegates to mios without shell evaluation.
# AI-related: /usr/bin/mios, /usr/share/mios/mios.toml [keybindings], mios-terminal

set -euo pipefail

case "${1:-}" in
    -h|--help) printf 'Usage: mios-ai-terminal\nEnter a prompt for MiOS AI. /exit or Ctrl-d closes this frontend.\n'; exit 0 ;;
    '') ;;
    *) printf 'mios-ai-terminal: unsupported option: %s\n' "$1" >&2; exit 64 ;;
esac
command -v mios >/dev/null || { printf 'mios-ai-terminal: MiOS CLI is missing\n' >&2; exit 1; }
printf 'MiOS AI — enter a prompt; /exit or Ctrl-d leaves.\n'
while IFS= read -r -p 'MiOS> ' _mios_prompt; do
    [[ "$_mios_prompt" == /exit ]] && break
    [[ -n "$_mios_prompt" ]] || continue
    # One argument: metacharacters and pasted multiline text are never eval'd.
    if ! /usr/lib/mios/mcp/.venv/bin/python3 /usr/bin/mios --tools "$_mios_prompt"; then
        printf 'MiOS AI request failed; the session is still available.\n' >&2
    fi
done
