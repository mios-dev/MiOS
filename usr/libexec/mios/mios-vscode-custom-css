def log(msg, verbose=False, is_verbose=False):
    if not verbose or is_verbose:
        print(f"[mios-vscode-custom-css] {msg}")

def get_candidate_homes():
    homes = set()
    cur_home = os.environ.get("HOME")
    if cur_home and os.path.isdir(cur_home):
        homes.add(os.path.abspath(cur_home))

    for base in ["/home", "/var/home"]:
        if os.path.isdir(base):
            for u in os.listdir(base):
                p = os.path.join(base, u)
                if os.path.isdir(p):
                    homes.add(p)

    if os.path.isdir("/root"):
        homes.add("/root")
    if os.path.isdir("/etc/skel"):
        homes.add("/etc/skel")
    if os.path.isdir("/var/lib/mios/agents"):
        homes.add("/var/lib/mios/agents")

    # Operator dotfiles boundary
    ws = os.environ.get("MIOS_ROOT") or os.getcwd()
    dotfiles_dir = os.path.join(ws, ".dotfiles")
    if os.path.isdir(dotfiles_dir):
        homes.add(dotfiles_dir)

    return sorted(list(homes))

def locate_ext_dirs(homes, explicit_target=None):
    dirs = set()
    if explicit_target:
        dirs.add(os.path.abspath(explicit_target))
        return list(dirs)

    for h in homes:
        for p in EXT_DIR_PATTERNS:
            target = os.path.join(h, p)
            if os.path.isdir(target) or os.path.isdir(os.path.dirname(target)):
                dirs.add(target)

    # Global code-server extensions dir if present
    for g in ["/usr/lib/code-server/extensions", "/usr/share/code-server/extensions"]:
        if os.path.isdir(g) or os.path.isdir(os.path.dirname(g)):
            dirs.add(g)

    return sorted(list(dirs))

def locate_settings_files(homes, explicit_target=None):
    files = set()
    if explicit_target:
        files.add(os.path.abspath(explicit_target))
        return list(files)

    for h in homes:
        for p in SETTINGS_PATTERNS:
            target = os.path.join(h, p)
            if os.path.isfile(target) or os.path.isdir(os.path.dirname(target)):
                files.add(target)

    return sorted(list(files))

def locate_workbench_html_files():
    candidates = []
    search_roots = [
        "/usr/lib/code-server",
        "/usr/share/code-server",
        "/opt/visual-studio-code",
        "/usr/share/code",
        "/usr/share/code-insiders",
    ]
    known_rel_paths = [
        "lib/vscode/out/vs/code/browser/workbench/workbench.html",
        "out/vs/code/browser/workbench/workbench.html",
        "out/vs/code/electron-sandbox/workbench/workbench.html",
        "resources/app/out/vs/code/electron-sandbox/workbench/workbench.html",
        "resources/app/out/vs/code/browser/workbench/workbench.html",
    ]
    skip_dirs = {"node_modules", ".git", "test", "tests", "docs", "documentation", "cache", ".cache"}

    for r in search_roots:
        if not os.path.isdir(r):
            continue
        # 1. Fast path: check known relative paths
        found_in_root = False
        for rel in known_rel_paths:
            target = os.path.join(r, rel)
            if os.path.isfile(target):
                candidates.append(target)
                found_in_root = True

        if found_in_root:
            continue

        # 2. Targeted fallback walk with skip_dirs pruning
        for root, dirs, files in os.walk(r):
            dirs[:] = [d for d in dirs if d not in skip_dirs]
            for f in files:
                if f.startswith("workbench") and f.endswith(".html"):
                    fp = os.path.join(root, f)
                    if os.path.isfile(fp):
                        candidates.append(fp)

    return sorted(list(set(candidates)))

def install_extension(ext_dirs, dry_run=False, verbose=False):
    # Resolve CSS extension source dir
    if not os.path.isdir(EXT_SRC_DIR):
        ws_cand = os.path.join(os.getcwd(), "usr/share/mios/extensions/be5invis.vscode-custom-css")
        src_dir = ws_cand if os.path.isdir(ws_cand) else None
    else:
        src_dir = EXT_SRC_DIR

    # Resolve Theme extension source dir
    if not os.path.isdir(THEME_SRC_DIR):
        theme_cand = os.path.join(os.getcwd(), "usr/share/mios/extensions/mios-theme-mobile")
        theme_src = theme_cand if os.path.isdir(theme_cand) else None
    else:
        theme_src = THEME_SRC_DIR

    packages_to_install = []
    if src_dir and os.path.isdir(src_dir):
        packages_to_install.append(("be5invis.vscode-custom-css", src_dir))
    if theme_src and os.path.isdir(theme_src):
        packages_to_install.append(("mios-theme-mobile", theme_src))

    if not packages_to_install:
        log("ERROR: No extension source directories found.", is_verbose=True)
        return False

    success = True
    for d in ext_dirs:
        for pkg_name, s_dir in packages_to_install:
            dest_pkg = os.path.join(d, pkg_name)
            log(f"Installing extension to: {dest_pkg}", verbose=True, is_verbose=verbose)
            if dry_run:
                continue
            try:
                os.makedirs(d, exist_ok=True)
                if os.path.exists(dest_pkg):
                    if os.path.islink(dest_pkg):
                        os.unlink(dest_pkg)
                    elif os.path.isdir(dest_pkg):
                        shutil.rmtree(dest_pkg)
                shutil.copytree(s_dir, dest_pkg)
                log(f"  Installed {dest_pkg}")
            except Exception as e:
                log(f"  Failed installing to {dest_pkg}: {e}", is_verbose=True)
                success = False

    return success

def configure_settings(settings_files, dry_run=False, verbose=False):
    success = True
    for sf in settings_files:
        log(f"Configuring settings in: {sf}", verbose=True, is_verbose=verbose)
        if dry_run:
            continue
        data = {}
        if os.path.isfile(sf):
            try:
                with open(sf, "r", encoding="utf-8") as f:
                    content = f.read().strip()
                    if content:
                        data = json.loads(content)
            except Exception as e:
                log(f"  Warning: failed reading JSON from {sf} ({e}), overwriting.", is_verbose=True)
                data = {}

        # Merge defaults
        for k, v in DEFAULT_SETTINGS.items():
            if k == "vscode_custom_css.imports":
                current_imports = data.get(k, [])
                if not isinstance(current_imports, list):
                    current_imports = []
                for item in v:
                    if item not in current_imports:
                        current_imports.append(item)
                data[k] = current_imports
            else:
                data[k] = v

        # Merge color customizations (frameless borders)
        colors = data.get("workbench.colorCustomizations")
        if not isinstance(colors, dict):
            colors = {}
        for ck, cv in DEFAULT_COLOR_CUSTOMIZATIONS.items():
            if ck not in colors:
                colors[ck] = cv
        data["workbench.colorCustomizations"] = colors

        try:
            os.makedirs(os.path.dirname(sf), exist_ok=True)
            with open(sf, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=4)
                f.write("\n")
            log(f"  Updated settings in {sf}")
        except Exception as e:
            log(f"  Failed writing settings to {sf}: {e}", is_verbose=True)
            success = False

    return success

def patch_workbench_html(html_path, dry_run=False, verbose=False):
    if not os.path.isfile(html_path):
        log(f"Workbench file not found: {html_path}", is_verbose=True)
        return False

    try:
        with open(html_path, "r", encoding="utf-8") as f:
            content = f.read()

        session_id = str(uuid.uuid4())
        backup_path = f"{html_path}.{session_id}.bak-custom-css"

        # Check if already patched
        if "<!-- !! VSCODE-CUSTOM-CSS-START !!" in content:
            log(f"Workbench already patched: {html_path}", verbose=True, is_verbose=verbose)
            return True

        if dry_run:
            log(f"Would patch workbench: {html_path}", is_verbose=verbose)
            return True

        # Write backup
        with open(backup_path, "w", encoding="utf-8") as f:
            f.write(content)

        # Remove CSP header restriction if present
        clean_content = re.sub(
            r'<meta\s+http-equiv="Content-Security-Policy"[\s\S]*?\/>',
            "",
            content
        )

        css_content = ""
        if os.path.isfile(CSS_FILE):
            try:
                with open(CSS_FILE, "r", encoding="utf-8") as cf:
                    css_content = cf.read()
            except Exception:
                css_content = ""

        inject_tag = f'<link rel="stylesheet" href="file://{CSS_FILE}">\n'
        if css_content:
            inject_tag += f'<style id="mios-custom-terminal-css">\n{css_content}\n</style>\n'

        patch_block = (
            f"<!-- !! VSCODE-CUSTOM-CSS-SESSION-ID {session_id} !! -->\n"
            f"<!-- !! VSCODE-CUSTOM-CSS-START !! -->\n"
            f"{inject_tag}"
            f"<!-- !! VSCODE-CUSTOM-CSS-END !! -->\n</head>"
        )

        patched_content = clean_content.replace("</head>", patch_block)
        with open(html_path, "w", encoding="utf-8") as f:
            f.write(patched_content)

        log(f"Successfully patched workbench: {html_path}")
        return True
    except Exception as e:
        log(f"Failed patching workbench {html_path}: {e}", is_verbose=True)
        return False

def unpatch_workbench_html(html_path, dry_run=False, verbose=False):
    if not os.path.isfile(html_path):
        return False

    try:
        with open(html_path, "r", encoding="utf-8") as f:
            content = f.read()

        m = re.search(r"<!-- !! VSCODE-CUSTOM-CSS-SESSION-ID ([0-9a-fA-F-]+) !! -->", content)
        if not m:
            log(f"No custom CSS patch detected in: {html_path}", is_verbose=verbose)
            return True

        session_id = m.group(1)
        backup_path = f"{html_path}.{session_id}.bak-custom-css"

        if dry_run:
            log(f"Would unpatch workbench: {html_path}", is_verbose=verbose)
            return True

        if os.path.isfile(backup_path):
            shutil.copyfile(backup_path, html_path)
            os.unlink(backup_path)
            log(f"Restored workbench from backup: {backup_path}")
        else:
            # Strip patch blocks
            cleaned = re.sub(
                r"<!-- !! VSCODE-CUSTOM-CSS-SESSION-ID [\s\S]*?<!-- !! VSCODE-CUSTOM-CSS-END !! -->\n",
                "",
                content
            )
            with open(html_path, "w", encoding="utf-8") as f:
                f.write(cleaned)
            log(f"Cleaned patch block from: {html_path}")

        return True
    except Exception as e:
        log(f"Failed unpatching workbench {html_path}: {e}", is_verbose=True)
        return False

def check_status(verbose=False):
    homes = get_candidate_homes()
    ext_dirs = locate_ext_dirs(homes)
    settings_files = locate_settings_files(homes)
    workbench_files = locate_workbench_html_files()

    css_found = os.path.isfile(CSS_FILE) or os.path.isfile(os.path.join(os.getcwd(), "usr/share/mios/themes/code-server-terminal.css"))
    ext_found = os.path.isdir(EXT_SRC_DIR) or os.path.isdir(os.path.join(os.getcwd(), "usr/share/mios/extensions/be5invis.vscode-custom-css"))
    theme_found = os.path.isdir(THEME_SRC_DIR) or os.path.isdir(os.path.join(os.getcwd(), "usr/share/mios/extensions/mios-theme-mobile"))
    vsix_found = os.path.isfile(VSIX_SRC_FILE) or os.path.isfile(os.path.join(os.getcwd(), "usr/share/mios/extensions/vscode-custom-css-7.5.1.vsix"))

    print("[mios-vscode-custom-css] Status:")
    print(f"  CSS Source: {CSS_FILE} ({'exists' if css_found else 'missing'})")
    print(f"  Extension Dir: {EXT_SRC_DIR} ({'exists' if ext_found else 'missing'})")
    print(f"  Theme Dir: {THEME_SRC_DIR} ({'exists' if theme_found else 'missing'})")
    print(f"  VSIX Package: {VSIX_SRC_FILE} ({'exists' if vsix_found else 'missing'})")
    print("\n  Extensions directories detected:")
    for d in ext_dirs:
        css_inst = os.path.isdir(os.path.join(d, "be5invis.vscode-custom-css"))
        theme_inst = os.path.isdir(os.path.join(d, "mios-theme-mobile"))
        print(f"    - {d}: [CSS: {'INSTALLED' if css_inst else 'missing'}, Theme: {'INSTALLED' if theme_inst else 'missing'}]")

    print("\n  Settings files detected:")
    for sf in settings_files:
        has_cfg = False
        theme_name = "default"
        if os.path.isfile(sf):
            try:
                with open(sf, "r") as f:
                    cfg = json.load(f)
                    has_cfg = "vscode_custom_css.imports" in cfg
                    theme_name = cfg.get("workbench.colorTheme", "none")
            except Exception:
                pass
        print(f"    - {sf}: {'CONFIGURED' if has_cfg else 'not configured'} (theme: {theme_name})")

    print("\n  Workbench HTML candidates:")
    for wb in workbench_files:
        patched = False
        if os.path.isfile(wb):
            with open(wb, "r", errors="ignore") as f:
                patched = "<!-- !! VSCODE-CUSTOM-CSS-START !!" in f.read()
        print(f"    - {wb}: {'PATCHED' if patched else 'unpatched'}")

def main():
    parser = argparse.ArgumentParser(
        description="MiOS VS Code and code-server Custom CSS extension installer and workbench patcher."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # install command
    p_install = subparsers.add_parser("install", help="Install extension and configure settings across environments")
    p_install.add_argument("--all", action="store_true", help="Install across all detected user and code-server homes")
    p_install.add_argument("--extensions-dir", help="Explicit extensions directory target")
    p_install.add_argument("--settings-file", help="Explicit settings.json file target")
    p_install.add_argument("--patch-html", action="store_true", help="Also attempt to patch detected workbench.html files")
    p_install.add_argument("--dry-run", action="store_true", help="Simulate actions without writing files")
    p_install.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    # patch command
    p_patch = subparsers.add_parser("patch", help="Patch workbench.html with custom CSS tag")
    p_patch.add_argument("--target", help="Explicit workbench.html file to patch")
    p_patch.add_argument("--dry-run", action="store_true", help="Simulate actions")
    p_patch.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    # unpatch command
    p_unpatch = subparsers.add_parser("unpatch", help="Remove custom CSS patch from workbench.html")
    p_unpatch.add_argument("--target", help="Explicit workbench.html file to unpatch")
    p_unpatch.add_argument("--dry-run", action="store_true", help="Simulate actions")
    p_unpatch.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    # status command
    p_status = subparsers.add_parser("status", help="Check status of installed extensions and settings")
    p_status.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    args = parser.parse_args()

    if args.command == "status":
        check_status(verbose=args.verbose)
        return 0

    if args.command == "install":
        homes = get_candidate_homes()
        ext_dirs = locate_ext_dirs(homes, explicit_target=args.extensions_dir)
        settings_files = locate_settings_files(homes, explicit_target=args.settings_file)

        ok1 = install_extension(ext_dirs, dry_run=args.dry_run, verbose=args.verbose)
        ok2 = configure_settings(settings_files, dry_run=args.dry_run, verbose=args.verbose)

        if args.patch_html:
            for wb in locate_workbench_html_files():
                patch_workbench_html(wb, dry_run=args.dry_run, verbose=args.verbose)

        return 0 if (ok1 and ok2) else 1

    if args.command == "patch":
        targets = [args.target] if args.target else locate_workbench_html_files()
        if not targets:
            log("No workbench.html files found to patch.")
            return 0
        all_ok = True
        for t in targets:
            if not patch_workbench_html(t, dry_run=args.dry_run, verbose=args.verbose):
                all_ok = False
        return 0 if all_ok else 1

    if args.command == "unpatch":
        targets = [args.target] if args.target else locate_workbench_html_files()
        if not targets:
            log("No workbench.html files found to unpatch.")
            return 0
        all_ok = True
        for t in targets:
            if not unpatch_workbench_html(t, dry_run=args.dry_run, verbose=args.verbose):
                all_ok = False
        return 0 if all_ok else 1

if __name__ == "__main__":
    sys.exit(main())
