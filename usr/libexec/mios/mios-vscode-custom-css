def log(msg, verbose=False, is_verbose=False):
    if not verbose or is_verbose:
        print(f"[mios-vscode-custom-css] {msg}")

def get_candidate_homes():
    homes = set()
    cur_home = os.environ.get("HOME")
    if cur_home and os.path.isdir(cur_home):
        homes.add(os.path.abspath(cur_home))

    for base in ["/home", "/var/home"]:
        if os.path.isdir(base):
            for u in os.listdir(base):
                p = os.path.join(base, u)
                if os.path.isdir(p):
                    homes.add(p)

    if os.path.isdir("/root"):
        homes.add("/root")
    if os.path.isdir("/etc/skel"):
        homes.add("/etc/skel")
    if os.path.isdir("/var/lib/mios/agents"):
        homes.add("/var/lib/mios/agents")

    # Operator dotfiles boundary
    ws = os.environ.get("MIOS_ROOT") or os.getcwd()
    dotfiles_dir = os.path.join(ws, ".dotfiles")
    if os.path.isdir(dotfiles_dir):
        homes.add(dotfiles_dir)

    return sorted(list(homes))

def locate_ext_dirs(homes, explicit_target=None):
    dirs = set()
    if explicit_target:
        dirs.add(os.path.abspath(explicit_target))
        return list(dirs)

    for h in homes:
        for p in EXT_DIR_PATTERNS:
            target = os.path.join(h, p)
            if os.path.isdir(target) or os.path.isdir(os.path.dirname(target)):
                dirs.add(target)

    # Global code-server extensions dir if present
    for g in ["/usr/lib/code-server/extensions", "/usr/share/code-server/extensions"]:
        if os.path.isdir(g) or os.path.isdir(os.path.dirname(g)):
            dirs.add(g)

    return sorted(list(dirs))

def locate_settings_files(homes, explicit_target=None):
    files = set()
    if explicit_target:
        files.add(os.path.abspath(explicit_target))
        return list(files)

    for h in homes:
        for p in SETTINGS_PATTERNS:
            target = os.path.join(h, p)
            if os.path.isfile(target) or os.path.isdir(os.path.dirname(target)):
                files.add(target)

    return sorted(list(files))

def locate_workbench_html_files():
    candidates = []
    search_roots = [
        "/usr/lib/code-server",
        "/usr/share/code-server",
        "/opt/visual-studio-code",
        "/usr/share/code",
        "/usr/share/code-insiders",
    ]
    known_rel_paths = [
        "lib/vscode/out/vs/code/browser/workbench/workbench.html",
        "out/vs/code/browser/workbench/workbench.html",
        "out/vs/code/electron-sandbox/workbench/workbench.html",
        "resources/app/out/vs/code/electron-sandbox/workbench/workbench.html",
        "resources/app/out/vs/code/browser/workbench/workbench.html",
    ]
    skip_dirs = {"node_modules", ".git", "test", "tests", "docs", "documentation", "cache", ".cache"}

    for r in search_roots:
        if not os.path.isdir(r):
            continue
        # 1. Fast path: check known relative paths
        found_in_root = False
        for rel in known_rel_paths:
            target = os.path.join(r, rel)
            if os.path.isfile(target):
                candidates.append(target)
                found_in_root = True

        if found_in_root:
            continue

        # 2. Targeted fallback walk with skip_dirs pruning
        for root, dirs, files in os.walk(r):
            dirs[:] = [d for d in dirs if d not in skip_dirs]
            for f in files:
                if f.startswith("workbench") and f.endswith(".html"):
                    fp = os.path.join(root, f)
                    if os.path.isfile(fp):
                        candidates.append(fp)

    return sorted(list(set(candidates)))

def install_extension(ext_dirs, dry_run=False, verbose=False):
    # Resolve CSS extension source dir
    if not os.path.isdir(EXT_SRC_DIR):
        ws_cand = os.path.join(os.getcwd(), "usr/share/mios/extensions/be5invis.vscode-custom-css")
        src_dir = ws_cand if os.path.isdir(ws_cand) else None
    else:
        src_dir = EXT_SRC_DIR

    # Resolve Theme extension source dir
    if not os.path.isdir(THEME_SRC_DIR):
        theme_cand = os.path.join(os.getcwd(), "usr/share/mios/extensions/mios-theme-mobile")
        theme_src = theme_cand if os.path.isdir(theme_cand) else None
    else:
        theme_src = THEME_SRC_DIR

    packages_to_install = []
    if src_dir and os.path.isdir(src_dir):
        packages_to_install.append(("be5invis.vscode-custom-css", src_dir))
    if theme_src and os.path.isdir(theme_src):
        packages_to_install.append(("mios-theme-mobile", theme_src))

    if not packages_to_install:
        log("ERROR: No extension source directories found.", is_verbose=True)
        return False

    success = True
    for d in ext_dirs:
        for pkg_name, s_dir in packages_to_install:
            dest_pkg = os.path.join(d, pkg_name)
            log(f"Installing extension to: {dest_pkg}", verbose=True, is_verbose=verbose)
            if dry_run:
                continue
            try:
                os.makedirs(d, exist_ok=True)
                if os.path.exists(dest_pkg):
                    if os.path.islink(dest_pkg):
                        os.unlink(dest_pkg)
                    elif os.path.isdir(dest_pkg):
                        shutil.rmtree(dest_pkg)
                shutil.copytree(s_dir, dest_pkg)
                log(f"  Installed {dest_pkg}")
            except Exception as e:
                log(f"  Failed installing to {dest_pkg}: {e}", is_verbose=True)
                success = False

    return success

def configure_settings(settings_files, dry_run=False, verbose=False):
    success = True
    for sf in settings_files:
        log(f"Configuring settings in: {sf}", verbose=True, is_verbose=verbose)
        if dry_run:
            continue
        data = {}
        if os.path.isfile(sf):
            try:
                with open(sf, "r", encoding="utf-8") as f:
                    content = f.read().strip()
                    if content:
                        data = json.loads(content)
            except Exception as e:
                log(f"  Warning: failed reading JSON from {sf} ({e}), overwriting.", is_verbose=True)
                data = {}

        # Merge defaults
        for k, v in DEFAULT_SETTINGS.items():
            if k == "vscode_custom_css.imports":
                current_imports = data.get(k, [])
                if not isinstance(current_imports, list):
                    current_imports = []
                for item in v:
                    if item not in current_imports:
                        current_imports.append(item)
                data[k] = current_imports
            else:
                data[k] = v

        # Merge color customizations (frameless borders)
        colors = data.get("workbench.colorCustomizations")
        if not isinstance(colors, dict):
            colors = {}
        for ck, cv in DEFAULT_COLOR_CUSTOMIZATIONS.items():
            if ck not in colors:
                colors[ck] = cv
        data["workbench.colorCustomizations"] = colors

        try:
            os.makedirs(os.path.dirname(sf), exist_ok=True)
            with open(sf, "w", encoding="utf-8") as f:
                json.dump(data, f, indent=4)
                f.write("\n")
            log(f"  Updated settings in {sf}")
        except Exception as e:
            log(f"  Failed writing settings to {sf}: {e}", is_verbose=True)
            success = False

    return success

# One-line anchors: the measured code-server 4.139.1 workbench.js text each bake patch rewrites.
CS_JS_SCROLLBAR = 'get scrollbarWidth(){return this._configurationService.getValue("workbench.experimental.modernUI")===!0?10:14}'
CS_JS_PERIMETER = (r'var ([\w$]+)=4,([\w$]+)=0,([\w$]+)=(VALUE),([\w$]+)=0;'
                   r'function [\w$]+\(s\)\{return s\.isModernUICompact\(\)\?\2:\1\}'
                   r'function [\w$]+\(s\)\{return s\.isModernUICompact\(\)\?\3:\1\}')
CS_CSS_PERIMETER = ".monaco-workbench.floating-panels.modern-ui-compact{--modern-ui-floating-card-outer-margin:%dpx}"
BLOCK_START = "<!-- !! VSCODE-CUSTOM-CSS-START !! -->"
BLOCK_END = "<!-- !! VSCODE-CUSTOM-CSS-END !! -->"
ORIG_SUFFIX = ".mios-orig"
_BLOCK_RE = re.compile(r"(?:<!-- !! VSCODE-CUSTOM-CSS-SESSION-ID [0-9a-fA-F-]+ !! -->\n)?"
                       + re.escape(BLOCK_START) + r"[\s\S]*?" + re.escape(BLOCK_END) + r"\n?")
_SCROLLBAR_ANY = re.compile(re.escape(CS_JS_SCROLLBAR.rsplit("?", 1)[0]) + r"\?(\d+):14\}")
_PERIMETER_ANY = re.compile(CS_JS_PERIMETER.replace("VALUE", r"\d+"))


class BakeError(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def _read(path):
    with open(path, "r", encoding="utf-8") as f:
        return f.read()


def _write_atomic(path, text):
    """temp-file + rename in the target's directory, keeping the target's mode."""
    d = os.path.dirname(os.path.abspath(path))
    fd, tmp = tempfile.mkstemp(prefix=".mios-", dir=d)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        if os.path.exists(path):
            shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def _px(value):
    try:
        n = int(value)
    except (TypeError, ValueError):
        raise argparse.ArgumentTypeError(f"not a whole pixel count: {value!r}")
    if n < 0:
        raise argparse.ArgumentTypeError(f"negative pixel count: {n}")
    return n


def _edge_px(key):
    """[theme.edge].<key> through the ONE layered loader, when the flag is omitted."""
    here = os.path.dirname(os.path.abspath(__file__))
    for d in (os.path.join(here, "..", "..", "lib", "mios"), "/usr/lib/mios"):
        if os.path.isfile(os.path.join(d, "mios_toml.py")):
            sys.path.insert(0, d)
            break
    import mios_toml
    val = mios_toml.section(mios_toml.load_merged(), "theme.edge").get(key)
    try:
        return _px(val)
    except argparse.ArgumentTypeError as e:
        raise BakeError(2, f"[theme.edge].{key}: {e}")


def build_block(css_text, perimeter_px):
    return (f"{BLOCK_START}\n<style id=\"mios-custom-terminal-css\">\n{css_text}\n</style>\n"
            f"<style id=\"mios-edge-perimeter\">{CS_CSS_PERIMETER % perimeter_px}</style>\n{BLOCK_END}\n")


def _workbench_js(html_path):
    return os.path.join(os.path.dirname(os.path.abspath(html_path)), "workbench.js")


def _source(path):
    """The pristine upstream bytes: the .mios-orig backup when a bake already ran."""
    orig = path + ORIG_SUFFIX
    return (_read(orig), True) if os.path.isfile(orig) else (_read(path), False)


def bake_workbench(html_path, css_path, scrollbar_px, perimeter_px, dry_run=False):
    """Inject the stylesheet and rewrite both bundle constants; every anchor is checked before any write."""
    if not os.path.isfile(html_path):
        raise BakeError(2, f"anchor not found: {html_path}: </head> (no such file)")
    if not os.path.isfile(css_path):
        raise BakeError(2, f"stylesheet not found: {css_path}")
    js_path = _workbench_js(html_path)
    html = re.sub(r'<meta\s+http-equiv="Content-Security-Policy"[\s\S]*?\/>', "", _BLOCK_RE.sub("", _read(html_path)))
    if html.count("</head>") != 1:
        raise BakeError(2, f"anchor not found: {html_path}: </head>")
    if not os.path.isfile(js_path):
        raise BakeError(2, f"anchor not found: {js_path}: get scrollbarWidth (no such file)")
    js, js_has_orig = _source(js_path)
    if js.count(CS_JS_SCROLLBAR) != 1:
        raise BakeError(2, f"anchor not found: {js_path}: get scrollbarWidth")
    perim = list(re.finditer(CS_JS_PERIMETER.replace("VALUE", "4"), js))
    if len(perim) != 1:
        raise BakeError(2, f"anchor not found: {js_path}: COMPACT_FLOATING_PANEL_OUTER_MARGIN")
    m = perim[0]
    js_new = js[:m.start(4)] + str(perimeter_px) + js[m.end(4):]
    js_new = js_new.replace(CS_JS_SCROLLBAR, CS_JS_SCROLLBAR.rsplit("?", 1)[0] + f"?{scrollbar_px}:14}}")
    html_new = html.replace("</head>", build_block(_read(css_path), perimeter_px) + "</head>")
    if dry_run:
        log(f"Would bake {html_path} and {js_path}")
        return
    if not js_has_orig:
        shutil.copy2(js_path, js_path + ORIG_SUFFIX)
    _write_atomic(js_path, js_new)
    _write_atomic(html_path, html_new)
    log(f"Baked {html_path} (scrollbar {scrollbar_px}px, perimeter {perimeter_px}px)")


def verify_workbench(html_path, css_path, scrollbar_px, perimeter_px):
    """Return the list of differences between the baked tree and the stylesheet/pixel values."""
    errs = []
    html = _read(html_path) if os.path.isfile(html_path) else ""
    blocks = [b.group(0) for b in _BLOCK_RE.finditer(html)]
    css = _read(css_path) if os.path.isfile(css_path) else None
    if css is None or blocks != [build_block(css, perimeter_px)]:
        errs.append(f"code-server workbench.html: injected block differs from {css_path}")
    js_path = _workbench_js(html_path)
    js = _read(js_path) if os.path.isfile(js_path) else ""
    for name, rx, want in (("scrollbarWidth ModernUI", _SCROLLBAR_ANY, scrollbar_px),
                           ("COMPACT_FLOATING_PANEL_OUTER_MARGIN", _PERIMETER_ANY, perimeter_px)):
        found = [mm.group(1) if rx is _SCROLLBAR_ANY else mm.group(4) for mm in rx.finditer(js)]
        got = found[0] if len(found) == 1 else ("missing" if not found else "ambiguous")
        if got != str(want):
            errs.append(f"code-server workbench.js: {name}={got} want {want}")
    return errs


def unpatch_workbench_html(html_path, dry_run=False, verbose=False):
    if not os.path.isfile(html_path):
        return False
    try:
        for p in (html_path, _workbench_js(html_path)):
            orig = p + ORIG_SUFFIX
            if os.path.isfile(orig):
                if not dry_run:
                    os.replace(orig, p)
                log(f"Restored {p} from {orig}")
        content = _read(html_path)
        if _BLOCK_RE.search(content):
            if not dry_run:
                _write_atomic(html_path, _BLOCK_RE.sub("", content))
            log(f"Cleaned patch block from: {html_path}")
        return True
    except Exception as e:
        log(f"Failed unpatching workbench {html_path}: {e}", is_verbose=True)
        return False


