        print(f"    - {wb}: {'PATCHED' if patched else 'unpatched'}")

def main():
    parser = argparse.ArgumentParser(
        description="MiOS VS Code and code-server Custom CSS extension installer and workbench patcher."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # install command
    p_install = subparsers.add_parser("install", help="Install extension and configure settings across environments")
    p_install.add_argument("--all", action="store_true", help="Install across all detected user and code-server homes")
    p_install.add_argument("--extensions-dir", help="Explicit extensions directory target")
    p_install.add_argument("--settings-file", help="Explicit settings.json file target")
    p_install.add_argument("--dry-run", action="store_true", help="Simulate actions without writing files")
    p_install.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    # patch / verify commands (the code-server bake)
    for name, help_text in (("patch", "Bake the stylesheet and the two bundle patches into code-server's workbench"),
                            ("verify", "Exit 1 when the baked workbench differs from the stylesheet or the pixel values")):
        sp = subparsers.add_parser(name, help=help_text)
        sp.add_argument("--target", help="code-server workbench.html (default: every detected one)")
        sp.add_argument("--css", default=CSS_FILE, help="Stylesheet to inject (default: %(default)s)")
        sp.add_argument("--scrollbar-px", type=_px, help="TerminalScrollbarWidth.ModernUI (default: [theme.edge].code_server_scrollbar_px)")
        sp.add_argument("--perimeter-px", type=_px, help="COMPACT_FLOATING_PANEL_OUTER_MARGIN (default: [theme.edge].code_server_perimeter_px)")
        sp.add_argument("--dry-run", action="store_true", help="Simulate actions")
        sp.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    # unpatch command
    p_unpatch = subparsers.add_parser("unpatch", help="Remove custom CSS patch from workbench.html")
    p_unpatch.add_argument("--target", help="Explicit workbench.html file to unpatch")
    p_unpatch.add_argument("--dry-run", action="store_true", help="Simulate actions")
    p_unpatch.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    # status command
    p_status = subparsers.add_parser("status", help="Check status of installed extensions and settings")
    p_status.add_argument("-v", "--verbose", action="store_true", help="Verbose output")

    args = parser.parse_args()

    if args.command == "status":
        check_status(verbose=args.verbose)
        return 0

    if args.command == "install":
        homes = get_candidate_homes()
        ext_dirs = locate_ext_dirs(homes, explicit_target=args.extensions_dir)
        settings_files = locate_settings_files(homes, explicit_target=args.settings_file)

        ok1 = install_extension(ext_dirs, dry_run=args.dry_run, verbose=args.verbose)
        ok2 = configure_settings(settings_files, dry_run=args.dry_run, verbose=args.verbose)
        return 0 if (ok1 and ok2) else 1

    if args.command in ("patch", "verify"):
        targets = [args.target] if args.target else locate_workbench_html_files()
        if not targets:
            log("ERROR: no code-server workbench.html to bake (empty target list)", is_verbose=True)
            return 2
        try:
            sb = _edge_px("code_server_scrollbar_px") if args.scrollbar_px is None else args.scrollbar_px
            pm = _edge_px("code_server_perimeter_px") if args.perimeter_px is None else args.perimeter_px
            if args.command == "patch":
                for t in targets:
                    bake_workbench(t, args.css, sb, pm, dry_run=args.dry_run)
                return 0
            errs = [e for t in targets for e in verify_workbench(t, args.css, sb, pm)]
        except BakeError as e:
            log(f"ERROR: {e}", is_verbose=True)
            return e.code
        for e in errs:
            log(f"VIOLATION: {e}", is_verbose=True)
        return 1 if errs else 0

    if args.command == "unpatch":
        targets = [args.target] if args.target else locate_workbench_html_files()
        if not targets:
            log("No workbench.html files found to unpatch.")
            return 0
        all_ok = True
        for t in targets:
            if not unpatch_workbench_html(t, dry_run=args.dry_run, verbose=args.verbose):
                all_ok = False
        return 0 if all_ok else 1

if __name__ == "__main__":
    sys.exit(main())
