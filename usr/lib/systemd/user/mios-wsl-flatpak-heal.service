/* AI-hint: User-level systemd unit that executes a script to restart stalled flatpak portal services in WSL2g environments to prevent sandbox-credential failures during application launches. */
/* AI-doc: usr/share/doc/mios/manual/user.md */

[Unit]
Description='MiOS' WSL2g flatpak portal heal -- restart inactive portals
Documentation=file:///usr/libexec/mios/mios-wsl-flatpak-heal
ConditionPathExists=/usr/libexec/mios/mios-wsl-flatpak-heal

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/mios-wsl-flatpak-heal
# Heal failures are not session-fatal -- log + continue, the next
# tick or the agent's pre-launch heal will try again.
SuccessExitStatus=0 1

[Install]
WantedBy=graphical-session.target
