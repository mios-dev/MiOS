# AI-hint: Triggers the mios-wsl-flatpak-heal.service every 5 minutes to keep the flatpak-portal active and prevent it from entering an idle timeout state in WSL environments.
/* AI-doc: usr/share/doc/mios/manual/user.md */

[Unit]
Description='MiOS' WSL2g flatpak portal heal cadence
Documentation=file:///usr/libexec/mios/mios-wsl-flatpak-heal

[Timer]
OnActiveSec=30s
OnUnitActiveSec=5min
AccuracySec=30s
Unit=mios-wsl-flatpak-heal.service
Persistent=true

[Install]
WantedBy=timers.target
