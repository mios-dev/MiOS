/* AI-hint: Systemd unit that executes /usr/libexec/mios/mios-sriov-init to initialize SR-IOV network interfaces during the multi-user.target boot stage. */
/* AI-doc: usr/share/doc/mios/manual/system.md */
[Unit]
Description='MiOS' Universal SR-IOV Initialization
After=network-pre.target
Wants=network-pre.target
ConditionVirtualization=!wsl
ConditionPathExists=/sys/class/net

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/mios-sriov-init
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
