# AI-hint: Systemd service unit for signed proxy WoL with SecureON payload and peer wake daemon (T-523, AGY-2121).
# AI-doc: usr/share/doc/mios/manual/ch12-networking-and-mesh.md

[Unit]
Description=MiOS Signed Proxy Wake-on-LAN Daemon with SecureON Payload
Documentation=file:///usr/libexec/mios/mios-wol-proxy
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/mios/install.env
EnvironmentFile=-/etc/mios/wol.env
ExecStart=/usr/libexec/mios/mios-wol-proxy daemon
Restart=on-failure
RestartSec=5s
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
