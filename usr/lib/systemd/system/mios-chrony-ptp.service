# AI-hint: systemd oneshot that generates the Chrony PTP drop-in on hosts exposing /dev/ptp0 (WSL2/Hyper-V), before chronyd starts.
[Unit]
Description=MiOS Chrony PTP Drop-in Generator
Documentation=man:chrony.conf(5)
ConditionPathExists=/dev/ptp0
Before=chronyd.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/mios-chrony-ptp-dropin
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
