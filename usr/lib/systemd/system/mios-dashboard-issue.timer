/* AI-hint: Systemd timer that triggers mios-dashboard-issue.service every 5 minutes to refresh the /etc/issue.d/ banner with real-time Quadlet status updates like service flapping and endpoint reachability. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_dashboard_issue_timer.md */
[Unit]
Description='MiOS' dashboard /etc/issue.d refresh timer
Documentation=file:///usr/libexec/mios/mios-dashboard-render-issue.sh

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=mios-dashboard-issue.service
Persistent=false

[Install]
WantedBy=timers.target
