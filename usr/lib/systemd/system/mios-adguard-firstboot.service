# AI-hint: Systemd unit that executes /usr/libexec/mios/mios-adguard-firstboot to generate the AdGuardHome.yaml config from mios.toml, injecting Tailscale IPs before the AdGuard container starts.
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' AdGuard Home first-boot config generator
After=network-online.target tailscaled.service
Wants=network-online.target
Before=mios-adguard.service
ConditionPathExists=/usr/libexec/mios/mios-adguard-firstboot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/mios/mios-adguard-firstboot

[Install]
WantedBy=multi-user.target
