[Unit]
Description=MiOS Local OCI Distribution Registry (T-510)
Documentation=https://github.com/mios-dev/mios
After=network-online.target podman.service
Wants=network-online.target

[Service]
Type=exec
Restart=on-failure
RestartSec=5s
ExecStartPre=-/usr/bin/podman rm -f mios-registry
ExecStart=/usr/bin/podman run --name mios-registry --rm \
    -p 127.0.0.1:5000:5000 \
    -v /var/lib/mios/registry:/var/lib/registry:Z \
    docker.io/library/registry:2
ExecStop=/usr/bin/podman stop -t 10 mios-registry

[Install]
WantedBy=multi-user.target
