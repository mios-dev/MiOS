/* AI-hint: Systemd unit that executes `mios-skills mine` to process the pgvector tool_call history into a skill catalog, automatically updating the shared catalog and reaping low-performing skills via `export-catalog` and `reap`. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_skills_miner_service.md */

[Unit]
Description='MiOS' Phase C.2 Sequential Pattern Mining over tool_call history
Documentation=file:///usr/libexec/mios/mios-skills
After=mios-pgvector.service mios-agent-pipe.service
Requires=mios-pgvector.service
ConditionPathExists=/usr/libexec/mios/mios-skills

[Service]
Type=oneshot
EnvironmentFile=-/etc/mios/userenv.sh
ExecStart=/usr/libexec/mios/mios-skills mine
# Refresh the cross-agent static catalog after every mine so
# offline Hermes / OpenCode deployments see new promoted skills
# without polling agent-pipe HTTP.
ExecStartPost=/usr/libexec/mios/mios-skills export-catalog
# P4-full: outcome-driven lifecycle -- demote PROMOTED skills whose recent success
# rate falls below the floor back to CANDIDATE. DRY-RUN (logs intended demotions);
# flip to `reap --apply` once the rate math is trusted on accumulated outcomes.
ExecStartPost=/usr/libexec/mios/mios-skills reap
# The miner is a pure pgvector consumer; keep its privileges low.
# DynamicUser would be ideal but we need read access to
# /etc/mios/userenv.sh for the SSOT env -- so plain nogroup nobody
# isn't enough. Run as the agent-pipe sysuser instead (uid 822).
User=mios-ai
Group=mios-ai
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# export-catalog writes /var/lib/mios/skills/catalog.json -- without
# this line ProtectSystem=strict refuses the open() call.
ReadWritePaths=/var/lib/mios/skills

[Install]
WantedBy=multi-user.target
