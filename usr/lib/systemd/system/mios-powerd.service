# AI-hint: Systemd service unit for the MiOS hardware power supply monitor and battery-aware AI inference downscaler daemon.
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' Hardware Power Supply Monitor and Battery-Aware AI Downscaler Daemon
Documentation=file:///usr/libexec/mios/hw/powerd.py
ConditionVirtualization=!container
After=systemd-udevd.service systemd-modules-load.service mios-llm-light.service
Wants=mios-llm-light.service

[Service]
Type=simple
ExecStart=/usr/libexec/mios/hw/powerd.py --daemon
Restart=always
RestartSec=5s
User=root
RuntimeDirectory=mios
RuntimeDirectoryMode=0755
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
