# AI-hint: One-shot first-boot Machine Owner Key (MOK) enrollment so the baked signed-UKI (rendered by automation/76-uki-render.sh + tools/generate-uki-cmdline.py) verifies under ENFORCING Secure Boot on the INSTALLED disk; mirrors...
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description='MiOS' first-boot MOK enrollment for Secure Boot UKI trust
Documentation=https://github.com/mios-dev/mios
# Idempotency sentinel (ANDed): once we have queued/confirmed enrollment the
# unit self-disables until the sentinel is removed.
ConditionPathExists=!/var/lib/mios/.mok-enrolled
# Trigger group (ORed): run only when a MOK cert is actually baked into the
# image -- the operator-generated key (generate-mok-key.sh) OR, on ucore-hci
# variants, the pre-signed ublue akmods key. Same two paths enroll-mok.sh's
# pick_key() resolves. No key baked -> unit is a clean no-op.
ConditionPathExists=|/etc/pki/mios/mok.der
ConditionPathExists=|/etc/pki/akmods/certs/akmods-ublue.der
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Hardening: this queues a boot-trust mutation and writes state -- keep it tight.
UMask=0077
StandardOutput=journal+console
StandardError=journal+console
# Inline (no runtime dependency on automation/enroll-mok.sh, which only exists
# in the build sandbox). Uses mokutil throughout -- sbctl is the WRONG tool for
# the Fedora bootc GRUB2+shim chain. --root-pw binds enrollment to the existing
# root password hash (non-interactive; MokManager asks for that same password on
# the next reboot), avoiding any shipped/hardcoded MOK secret.
ExecStart=/usr/bin/bash -c '\
  command -v mokutil >/dev/null 2>&1 || { echo "mokutil absent -- skipping MOK enrollment"; exit 0; }; \
  KEY=/etc/pki/mios/mok.der; \
  [ -f "$KEY" ] || KEY=/etc/pki/akmods/certs/akmods-ublue.der; \
  [ -f "$KEY" ] || { echo "no MOK key present -- nothing to enroll"; exit 0; }; \
  if mokutil --sb-state 2>/dev/null | grep -qi "SecureBoot disabled"; then \
    echo "Secure Boot disabled -- MOK enrollment not required"; exit 0; \
  fi; \
  if mokutil --test-key "$KEY" 2>/dev/null | grep -qi "already enrolled"; then \
    echo "MOK already enrolled: $KEY"; \
    install -d -m 0755 /var/lib/mios; : > /var/lib/mios/.mok-enrolled; exit 0; \
  fi; \
  echo "Queuing MOK for enrollment (root-pw bound): $KEY"; \
  mokutil --import "$KEY" --root-pw || { echo "mokutil --import failed"; exit 1; }; \
  install -d -m 0755 /var/lib/mios; : > /var/lib/mios/.mok-enrolled; \
  echo "MOK import queued -- confirm in MokManager on next reboot (enter the root password)."'

[Install]
WantedBy=multi-user.target
