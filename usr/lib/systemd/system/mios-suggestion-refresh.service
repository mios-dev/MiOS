# AI-hint: Systemd unit that triggers a one-shot script to refresh MiOS-aware starter chips in webui.db by querying pgvector and the refine endpoint, ensuring the UI prompt suggestions stay current.
/* AI-doc: usr/share/doc/mios/manual/system.md */

[Unit]
Description='MiOS' starter-chip refresh (revolving suggestions)
Documentation=file:///usr/libexec/mios/mios-suggestion-refresh
# Don't run before agent-pipe / mios-pgvector are up -- the
# shim queries pgvector for recent intents + hits the refine
# endpoint, so depend on the chain being warm.
After=mios-agent-pipe.service mios-pgvector.service mios-llm-light.service
Wants=mios-agent-pipe.service
ConditionPathExists=/usr/libexec/mios/mios-suggestion-refresh
ConditionPathExists=/var/lib/mios/open-webui/webui.db

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/mios-suggestion-refresh
# Soft-fail: a transient refine timeout shouldn't surface as a
# failed unit on the dashboard.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
