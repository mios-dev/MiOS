/* AI-hint: Defines the systemd target for a K3s master node role, ensuring the K3s service is active and mutually exclusive with other MiOS node profiles like desktop or headless. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_k3s_master_target.md */
[Unit]
Description='MiOS' K3s Master Role
Requires=multi-user.target k3s.service
After=multi-user.target
Conflicts=mios-compute.target mios-controller.target mios-desktop.target mios-endpoint.target mios-ha-node.target mios-headless.target mios-hybrid.target
AllowIsolate=yes

[Install]
WantedBy=multi-user.target
