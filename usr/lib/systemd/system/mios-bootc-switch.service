/* AI-hint: Systemd unit that triggers bootc switch via /usr/libexec/mios/bootc-switch-from-build.sh when a build sentinel in /var/lib/mios/forge-runner/last-build.txt is updated, automating the transition to a new image. */
/* AI-doc: usr/share/doc/mios/manual/system.md */

[Unit]
Description='MiOS' bootc-switch from local build sentinel
Documentation=file:///usr/libexec/mios/bootc-switch-from-build.sh
After=local-fs.target
ConditionPathExists=/var/lib/mios/forge-runner/last-build.txt
ConditionPathExists=/usr/bin/bootc

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/bootc-switch-from-build.sh
StandardOutput=journal
StandardError=journal
# bootc switch writes to ostree's state store; needs root.
User=root

[Install]
WantedBy=multi-user.target
