# AI-hint: Systemd service for CephFS transactional ledger replication and integrity verification.
# AI-related: usr/libexec/mios/storage/mios-ledger-sync, tests/test-ledger-sync.py, usr/share/mios/mios.toml

[Unit]
Description=MiOS CephFS Transactional Ledger Replication Service
Documentation=file:///usr/share/doc/mios/manual/ch66-v5-authority-inversion-and-cephfs-tiering.md
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/storage/mios-ledger-sync sync
User=root
Group=root
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300s

[Install]
WantedBy=multi-user.target
