# AI-hint: Systemd timer for off-site remote delta backup synchronization.
# AI-related: usr/lib/systemd/system/mios-backup-remote.service, usr/libexec/mios/storage/mios-backup-remote

[Unit]
Description=Daily Off-Site Remote Delta Snapshot Backup Timer
Documentation=file:///usr/share/doc/mios/manual/ch66-v5-authority-inversion-and-cephfs-tiering.md

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
