# AI-hint: Systemd service for structured parquet log archival and vector indexing from systemd journald.
# AI-related: /usr/libexec/mios/telemetry/log_archiver.py, mios-log-archiver.timer, mios-pgvector.service, multi-user.target

[Unit]
Description=MiOS Structured Parquet Log Archiver and Vector Indexer
Documentation=man:journald.conf(5) https://github.com/mios-dev/mios
After=systemd-journald.service mios-pgvector.service
Wants=mios-pgvector.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/telemetry/log_archiver.py --archive-dir /var/log/archive
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
