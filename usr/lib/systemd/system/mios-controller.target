# AI-hint: Defines the controller systemd target for MiOS, representing the cluster controller.
# AI-related: mios-controller, mios-headless.target
[Unit]
Description='MiOS' Controller Role
Requires=multi-user.target
After=multi-user.target
Conflicts=mios-compute.target mios-desktop.target mios-endpoint.target mios-ha-node.target mios-headless.target mios-hybrid.target mios-k3s-master.target
AllowIsolate=yes

[Install]
WantedBy=multi-user.target
