/* AI-hint: Systemd timer that triggers mios-suggestion-refresh.service every 10 minutes to update OWUI starter chips based on current system state, kanban data, and recent user intents. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_suggestion_refresh_timer.md */

[Unit]
Description='MiOS' starter-chip refresh cadence
Documentation=file:///usr/libexec/mios/mios-suggestion-refresh

[Timer]
# First refresh 2 min after boot so the chain has warmed up.
OnBootSec=2min
# Then every 10 min while running.
OnUnitActiveSec=10min
AccuracySec=1min
Unit=mios-suggestion-refresh.service
Persistent=true

[Install]
WantedBy=timers.target
