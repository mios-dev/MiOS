# AI-hint: Systemd service for zero-configuration mDNS peer discovery and WireGuard mesh configuration.
# AI-related: /usr/libexec/mios/net/mdns_mesh.py, network-online.target, wireguard.target, multi-user.target

[Unit]
Description=MiOS Zero-Configuration mDNS Peer Discovery & WireGuard Peering Daemon
After=network-online.target wireguard.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/libexec/mios/net/mdns_mesh.py --discover --render-config --output /etc/wireguard/wg0.conf
Restart=on-failure
RestartSec=5s
ProtectSystem=strict
ReadWritePaths=/etc/wireguard
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
