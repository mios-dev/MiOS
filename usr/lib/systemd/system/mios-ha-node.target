/* AI-hint: Defines the mios-ha-node.target unit to identify and configure a node as a High Availability cluster member, ensuring it conflicts with desktop/headless modes and requires corosync/pacemaker services. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_ha_node_target.md */
[Unit]
Description='MiOS' HA Cluster Node Role
Requires=multi-user.target corosync.service pacemaker.service
After=multi-user.target
Conflicts=mios-compute.target mios-controller.target mios-desktop.target mios-endpoint.target mios-headless.target mios-hybrid.target mios-k3s-master.target
AllowIsolate=yes

[Install]
WantedBy=multi-user.target
