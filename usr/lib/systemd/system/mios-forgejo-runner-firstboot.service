/* AI-hint: One-shot systemd service that executes the initial registration of the Forgejo runner using the local token if the runner is not yet configured, ensuring the runner is registered before the main service starts. */
/* AI-doc: usr/share/doc/mios/manual/system.md */
[Unit]
Description='MiOS' Forgejo Runner first-boot registration
Documentation=https://forgejo.org/docs/latest/admin/actions/
After=mios-forge.service mios-forge-firstboot.service
Wants=mios-forge.service
Before=mios-forgejo-runner.service
ConditionPathExists=/etc/mios/forge/runner-token
ConditionPathExists=!/srv/mios/forge-runner/.runner
StartLimitIntervalSec=1200
StartLimitBurst=6

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/mios/mios-forgejo-runner-firstboot.sh
TimeoutStartSec=180s
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
