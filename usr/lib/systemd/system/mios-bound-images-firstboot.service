# AI-hint: FBM first-boot bound-image provisioner unit (oneshot, sentinel-guarded, degrade-open). Runs mios-bound-images-firstboot once at first boot to pull [ai].firstboot_bound_images; enabled via 90-mios.preset.
# AI-doc: usr/share/doc/mios/manual/system.md
[Unit]
Description=First-boot Bound Images Provisioner
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/mios/.bound-images-firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/mios-bound-images-firstboot
RemainAfterExit=yes
TimeoutStartSec=10800
SuccessExitStatus=0 1 2 3

[Install]
WantedBy=multi-user.target
