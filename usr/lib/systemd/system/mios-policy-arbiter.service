/* AI-hint: Systemd unit for the WS-9 out-of-process HITL policy arbiter -- runs /usr/libexec/mios/mios-policy-arbiter (a stdlib loopback HTTP service) as the mios-ai user, answering the agent-pipe's HITL arbiter client with allow/deny... */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_policy_arbiter_service.md */
[Unit]
Description='MiOS' out-of-process HITL policy arbiter (WS-9)
After=network-online.target mios-agent-pipe.service
Wants=network-online.target
ConditionPathExists=/usr/libexec/mios/mios-policy-arbiter

[Service]
Type=simple
User=mios-ai
Group=mios-ai
Environment=MIOS_AGENT_PIPE_DIR=/usr/lib/mios/agent-pipe
EnvironmentFile=-/etc/mios/install.env
ExecStart=/usr/bin/python3 /usr/libexec/mios/mios-policy-arbiter
Restart=on-failure
RestartSec=15s
# Hardening: a stateless loopback decision service needs nothing but Python.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
