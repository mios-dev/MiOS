# AI-hint: First-boot initialization of /etc/mios/secrets.env (0600) for container services.
# AI-related: /usr/libexec/mios/sec/rotate-quadlet-secrets.py, /etc/mios/secrets.env
[Unit]
Description=MiOS Quadlet Secrets Environment Initialization
Before=basic.target
DefaultDependencies=no
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/mios/sec/rotate-quadlet-secrets.py --init

[Install]
WantedBy=multi-user.target
