/* AI-hint: Defines the systemd timer for the mios-skills-miner.service, controlling the periodic execution interval (default 60m) for background skill mining and pattern discovery. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_skills_miner_timer.md */
[Unit]
Description='MiOS' Phase C.2 skill-miner cadence (sequential pattern mining)
Documentation=file:///usr/libexec/mios/mios-skills

[Timer]
OnBootSec=10min
OnUnitActiveSec=60min
AccuracySec=2min
Unit=mios-skills-miner.service
Persistent=true

[Install]
WantedBy=timers.target
