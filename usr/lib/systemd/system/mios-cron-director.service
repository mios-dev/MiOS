/* AI-hint: Systemd unit file defining the mios-cron-director service, which executes the LLM-gated task scheduler as the mios-ai user to process rules from /etc/mios/cron-rules.toml. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_cron_director_service.md */
[Unit]
Description='MiOS' cron-director (LLM-gated recurring-task scheduler)
After=network-online.target mios-agent-pipe.service
Wants=network-online.target
ConditionPathExists=/usr/libexec/mios/mios-cron-director

[Service]
Type=simple
User=mios-ai
Group=mios-ai
ExecStart=/usr/libexec/mios/mios-cron-director
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=15s
# Read-only journal/log access is inherited from mios-ai's groups; the daemon
# only needs to read the rules file + write its state dir.

[Install]
WantedBy=multi-user.target
