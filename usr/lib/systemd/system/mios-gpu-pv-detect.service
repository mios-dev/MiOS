/* AI-hint: Systemd unit that executes /usr/libexec/mios/gpu-pv-detect to detect Hyper-V GPU Partitioning (GPU-PV) capabilities during boot, enabling hardware acceleration for guests on Microsoft Hyper-V hosts. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_gpu_pv_detect_service.md */
[Unit]
Description='MiOS' Hyper-V GPU-PV Guest Detection
DefaultDependencies=no
After=systemd-modules-load.service
Before=display-manager.service
ConditionVirtualization=microsoft

[Service]
Type=oneshot
ExecStart=/usr/libexec/mios/gpu-pv-detect
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
