/* AI-hint: Daily systemd timer that fires mios-pgvector-backup.service to snapshot the unified agent-plane Postgres+pgvector datastore, with Persistent=true so a missed run (machine off) executes at next boot. */
/* AI-doc: usr/share/doc/mios/manual/_harvest/usr_lib_systemd_system_mios_pgvector_backup_timer.md */
[Unit]
Description='MiOS' daily pgvector datastore backup schedule
Documentation=file:///usr/lib/systemd/system/mios-pgvector-backup.service

[Timer]
# Daily, shortly after midnight local time. Persistent=true catches up a missed
# run (machine asleep/off at the scheduled time) on the next boot. Randomized
# delay spreads the dump off the exact minute so it doesn't collide with other
# midnight jobs.
OnCalendar=*-*-* 00:30:00
Persistent=true
RandomizedDelaySec=15m
AccuracySec=5m

[Install]
WantedBy=timers.target
