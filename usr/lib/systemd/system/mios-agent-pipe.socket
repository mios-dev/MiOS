# AI-hint: Systemd socket activation unit for agent-pipe zero-downtime handoff (T-542, AGY-2140)
# AI-doc: usr/share/doc/mios/manual/ch31-socket-activation-handoff.md
[Unit]
Description=MiOS Agent-Pipe Zero-Downtime Socket Activation
Documentation=man:agent-pipe(1) file:///usr/share/doc/mios/manual/ch31-socket-activation-handoff.md
PartOf=mios-agent-pipe.service

[Socket]
ListenStream=8642
ListenStream=/run/mios/agent-pipe.sock
SocketMode=0660
Backlog=128
Service=mios-agent-pipe.service

[Install]
WantedBy=sockets.target
