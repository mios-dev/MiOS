# AI-hint: Systemd timer for daily automated PostgreSQL+pgvector backups.
# AI-related: usr/lib/systemd/system/mios-backup-pgvector.service, usr/libexec/mios/db/mios-backup-pgvector.py

[Unit]
Description=Daily and Pre-Upgrade Automated PostgreSQL+pgvector Backup Timer
Documentation=file:///usr/share/doc/mios/manual/ch66-v5-authority-inversion-and-cephfs-tiering.md

[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
