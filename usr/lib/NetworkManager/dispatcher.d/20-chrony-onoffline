#!/usr/bin/sh
# AI-hint: MiOS configuration and runtime asset for 20-chrony-onoffline.


export LC_ALL=C

chronyc=/usr/bin/chronyc

if [ $# -ge 2 ]; then
    case "$2" in
        up|down|connectivity-change)
            ;;
        dhcp4-change|dhcp6-change)
            ;;
        *)
            exit 0;;
    esac
fi


$chronyc onoffline > /dev/null 2>&1

exit 0
