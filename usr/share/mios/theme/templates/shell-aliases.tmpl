# AI-hint: System shell aliases derived from mios.toml [shell] SSOT (AGY-62).
# AI-related: usr/share/mios/theme/templates/shell-aliases.tmpl, etc/skel/.bashrc.d/mios

alias ll='@MIOS:shell_alias_ll@'
alias gs='@MIOS:shell_alias_gs@'
alias gp='@MIOS:shell_alias_gp@'

# Ensure Oh-My-Posh with MiOS theme is initialized in interactive shells
if [ -t 1 ] && command -v oh-my-posh >/dev/null 2>&1; then
    _omp_cfg="${HOME:-/root}/.config/oh-my-posh/mios.omp.json"
    [ -r "$_omp_cfg" ] || _omp_cfg="/usr/share/mios/oh-my-posh/mios.omp.json"
    if [ -r "$_omp_cfg" ]; then
        if [ -n "${BASH_VERSION:-}" ]; then
            eval "$(oh-my-posh init bash --config="$_omp_cfg")"
        elif [ -n "${ZSH_VERSION:-}" ]; then
            eval "$(oh-my-posh init zsh --config="$_omp_cfg")"
        fi
    fi
    unset _omp_cfg
fi

