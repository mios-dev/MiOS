# AI-hint: Defines the Docker build for the crawl4ai engine, providing a Python 3.12 environment with camoufox for stealth fallback and a FastAPI wrapper to process web scraping tasks via CDP or local Firefox.
# AI-related: mios-crawl4ai-service
FROM docker.io/library/python:3.12-slim

RUN printf 'label ::1/128 0\nlabel ::/0 1\nlabel 2002::/16 2\nlabel ::/96 3\nlabel ::ffff:0:0/96 4\nprecedence ::1/128 50\nprecedence ::/0 40\nprecedence 2002::/16 30\nprecedence ::/96 20\nprecedence ::ffff:0:0/96 100\n' >> /etc/gai.conf \
    && printf 'Acquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99force-ipv4

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN pip install --no-cache-dir \
        crawl4ai \
        "camoufox[geoip]" \
        fastapi \
        "uvicorn[standard]" \
        pydantic \
        playwright

RUN apt-get update \
    && playwright install-deps firefox \
    && rm -rf /var/lib/apt/lists/*

RUN python -m camoufox fetch

WORKDIR /app
EXPOSE 11235
CMD ["python", "/app/mios-crawl4ai-service.py"]
