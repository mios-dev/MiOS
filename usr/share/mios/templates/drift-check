# AI-hint: Drift check verifying {{description}} under the source-tree drift fitness-functions.
# AI-related: automation/98-drift-checks.sh
# AI-functions: check_{{name}}
check_{{name}}() {
    local hits=""
    if [[ -n "$hits" ]]; then
        printf '%s' "$hits" >&2
        _violation "drift violation in {{name}}: {{description}}"
    else
        echo "[98-drift-checks] check passed: {{name}}"
    fi
}
