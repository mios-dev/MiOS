# AI-hint: MiOS configuration and runtime asset for Containerfile.
# AI-related: /usr/share/mios/agents, mios-a2o, mios-frontier, mios-frontier-sync, mios-agents, mios-root, mios-agents-path

FROM ghcr.io/coder/code-server:latest

USER root
RUN apt-get -o Acquire::ForceIPv4=true update \
 && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
      tmux git curl ca-certificates jq ripgrep \
      nodejs npm python3 python3-pip python3-venv \
      build-essential less procps openssh-client tar gzip \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

USER coder
WORKDIR /home/coder
RUN curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 20 https://antigravity.google/cli/install.sh | bash
USER root
RUN install -m0755 /home/coder/.local/bin/agy /usr/local/bin/agy

COPY mios-a2o /usr/local/bin/mios-a2o
COPY mios-frontier /usr/local/bin/mios-frontier
COPY mios-frontier-sync /usr/local/bin/mios-frontier-sync
RUN chmod 0755 /usr/local/bin/mios-a2o /usr/local/bin/mios-frontier /usr/local/bin/mios-frontier-sync
COPY orchestrator-brief.md /usr/local/share/mios-agents/orchestrator-brief.md

RUN printf '%s\n' \
  '# MiOS: prefer the live tools from the bind-mounted deployed root.' \
  'if [ -d /mnt/mios-root/usr/share/mios/agents ]; then' \
  '  case ":$PATH:" in' \
  '    *:/mnt/mios-root/usr/share/mios/agents:*) : ;;' \
  '    *) PATH="/mnt/mios-root/usr/share/mios/agents:/mnt/mios-root/usr/bin:/mnt/mios-root/usr/libexec/mios:$PATH"; export PATH ;;' \
  '  esac' \
  'fi' \
  > /etc/profile.d/mios-agents-path.sh \
  && cat /etc/profile.d/mios-agents-path.sh >> /etc/bash.bashrc

USER coder
RUN git config --global user.name "MiOS Frontier" \
 && git config --global user.email "a2o@mios.local" \
 && git config --global --add safe.directory /mnt/mios-root
ENV PATH=/mnt/mios-root/usr/share/mios/agents:/mnt/mios-root/usr/bin:/mnt/mios-root/usr/libexec/mios:/usr/local/bin:/home/coder/.local/bin:$PATH \
    MIOS_A2O_ENGINE=agy \
    MIOS_A2O_WORK=/mnt/mios-root
