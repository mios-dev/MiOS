{
  "$schema": "vscode://schemas/color-theme",
  "name": "MiOS-Dev",
  "type": "dark",
  "colors": {
    "focusBorder": "#00000000",
    "foreground": "#d0d4d8",
    "widget.border": "#00000000",
    "widget.shadow": "#00000080",
    "selection.background": "#264f78",
    "descriptionForeground": "#747d88",
    "errorForeground": "#f48771",
    "icon.foreground": "#b9c0c8",

    "window.border": "#00000000",
    "window.activeBorder": "#00000000",
    "window.inactiveBorder": "#00000000",

    "titleBar.border": "#00000000",
    "titleBar.activeBackground": "#000000",
    "titleBar.activeForeground": "#d0d4d8",
    "titleBar.inactiveBackground": "#000000",
    "titleBar.inactiveForeground": "#5c6470",

    "activityBar.border": "#00000000",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#d0d4d8",
    "activityBar.inactiveForeground": "#5c6470",
    "activityBar.activeBorder": "#405568",
    "activityBarBadge.background": "#405568",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.border": "#00000000",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#b9c0c8",
    "sideBarSectionHeader.border": "#00000000",
    "sideBarSectionHeader.background": "#0b0d13",
    "sideBarSectionHeader.foreground": "#d0d4d8",
    "sideBarTitle.foreground": "#d0d4d8",

    "editorGroup.border": "#00000000",
    "editorGroup.emptyBackground": "#000000",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorGroupHeader.noTabsBorder": "#00000000",
    "editorGroupHeader.tabsBackground": "#000000",

    "tab.border": "#00000000",
    "tab.activeBorder": "#405568",
    "tab.activeBorderTop": "#00000000",
    "tab.activeBackground": "#000000",
    "tab.activeForeground": "#d0d4d8",
    "tab.inactiveBackground": "#000000",
    "tab.inactiveForeground": "#747d88",
    "tab.hoverBackground": "#0b0d13",
    "tab.hoverBorder": "#00000000",
    "tab.unfocusedActiveBorder": "#405568",

    "editor.background": "#000000",
    "editor.foreground": "#d0d4d8",
    "editorLineNumber.foreground": "#5c6470",
    "editorLineNumber.activeForeground": "#aeb7c2",
    "editorCursor.foreground": "#528bff",
    "editor.selectionBackground": "#264f7866",
    "editor.inactiveSelectionBackground": "#3a3d4140",
    "editor.selectionHighlightBackground": "#add6ff1a",
    "editor.wordHighlightBackground": "#57575740",
    "editor.wordHighlightStrongBackground": "#0049724d",
    "editor.lineHighlightBackground": "#0d1017",
    "editor.lineHighlightBorder": "#00000000",
    "editorGutter.background": "#000000",
    "editorGutter.modifiedBackground": "#264f78",
    "editorGutter.addedBackground": "#2ea043",
    "editorGutter.deletedBackground": "#da3633",

    "panel.border": "#00000000",
    "panel.background": "#000000",
    "panelTitle.border": "#00000000",
    "panelTitle.activeBorder": "#00000000",
    "panelTitle.activeForeground": "#d0d4d8",
    "panelTitle.inactiveForeground": "#747d88",
    "panelSection.border": "#00000000",
    "panelSectionHeader.border": "#00000000",
    "panelSectionHeader.background": "#0b0d13",
    "panel.dropBorder": "#00000000",

    "terminal.border": "#00000000",
    "terminal.tab.activeBorder": "#00000000",
    "terminalOverviewRuler.border": "#00000000",
    "terminalStickyScroll.border": "#00000000",
    "terminalStickyScrollHover.border": "#00000000",
    "terminal.findMatchBorder": "#00000000",
    "terminal.findMatchHighlightBorder": "#00000000",
    "terminal.background": "#000000",
    "terminal.foreground": "#b9c0c8",
    "terminalCursor.foreground": "#528bff",
    "terminal.selectionBackground": "#264f7866",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#f44747",
    "terminal.ansiGreen": "#6a9955",
    "terminal.ansiYellow": "#d7ba7d",
    "terminal.ansiBlue": "#569cd6",
    "terminal.ansiMagenta": "#c586c0",
    "terminal.ansiCyan": "#4dc9b0",
    "terminal.ansiWhite": "#d0d4d8",
    "terminal.ansiBrightBlack": "#5c6470",
    "terminal.ansiBrightRed": "#f85149",
    "terminal.ansiBrightGreen": "#3fb950",
    "terminal.ansiBrightYellow": "#e3b341",
    "terminal.ansiBrightBlue": "#79c0ff",
    "terminal.ansiBrightMagenta": "#d2a8ff",
    "terminal.ansiBrightCyan": "#56d4dd",
    "terminal.ansiBrightWhite": "#ffffff",

    "statusBar.border": "#00000000",
    "statusBar.background": "#0c0e14",
    "statusBar.foreground": "#b9c0c8",
    "statusBar.debuggingBackground": "#1e222b",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBar.debuggingBorder": "#00000000",
    "statusBar.noFolderBackground": "#0c0e14",
    "statusBar.noFolderForeground": "#b9c0c8",
    "statusBar.noFolderBorder": "#00000000",
    "statusBarItem.hoverBackground": "#ffffff14",
    "statusBarItem.activeBackground": "#ffffff20",

    "quickInput.background": "#0e1117",
    "quickInput.foreground": "#d0d4d8",
    "quickInputList.focusBackground": "#1a2130",
    "quickInputList.focusForeground": "#ffffff",
    "quickInputTitle.background": "#0e1117",

    "input.background": "#07080b",
    "input.foreground": "#d0d4d8",
    "input.border": "#1f2430",
    "input.placeholderForeground": "#5c6470",
    "inputOption.activeBorder": "#405568",

    "dropdown.background": "#0e1117",
    "dropdown.foreground": "#d0d4d8",
    "dropdown.border": "#1f2430",

    "menu.background": "#0e1117",
    "menu.foreground": "#d0d4d8",
    "menu.border": "#1f2430",
    "menu.selectionBackground": "#1a2130",
    "menu.selectionForeground": "#ffffff",

    "notifications.background": "#0e1117",
    "notifications.foreground": "#d0d4d8",
    "notifications.border": "#1f2430",
    "notificationToast.border": "#1f2430",

    "sash.hoverBorder": "#00000000",
    "scrollbarSlider.background": "#79797920",
    "scrollbarSlider.hoverBackground": "#64646440",
    "scrollbarSlider.activeBackground": "#bfbfbf40"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6a737d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Operators",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator.expression"],
      "settings": {
        "foreground": "#569cd6"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#98c379"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#61afef"
      }
    },
    {
      "name": "Types & Classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Variables & Constants",
      "scope": ["variable", "constant", "support.constant"],
      "settings": {
        "foreground": "#e06c75"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": ["punctuation", "meta.brace"],
      "settings": {
        "foreground": "#abb2bf"
      }
    }
  ]
}
