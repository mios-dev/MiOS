# AI-hint: MiOS mios-piper container. (WS-7 pods-as-SSOT).
# DO NOT EDIT -- regenerate via tools/generate-pod-quadlets.py from [containers.mios-piper] in mios.toml.
# /usr/share/containers/systemd/mios-piper.container

[Unit]
After=network-online.target mios-cdi-detect.service systemd-tmpfiles-setup.service
AssertPathExists=/var/lib/mios/piper/models/en_US-lessac-medium.onnx
Description='MiOS' Piper/Kokoro Streaming TTS Engine (piper-http)
Documentation=https://github.com/rhasspy/piper
Wants=network-online.target

[Container]
ContainerName=mios-piper
Environment=PORT=${MIOS_PORT_PIPER:-8179}
EnvironmentFile=/etc/mios/install.env
Exec=--model /models/en_US-lessac-medium.onnx --port ${MIOS_PORT_PIPER:-8179} --host 0.0.0.0
GlobalArgs=--storage-opt=additionalimagestore=/usr/lib/bootc/storage
Group=831
HealthCmd=curl -fsS http://localhost:${MIOS_PORT_PIPER:-8179}/health || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s
HealthTimeout=10s
Image=ghcr.io/rhasspy/piper:latest
Label=org.opencontainers.image.title=mios-piper
Label=org.opencontainers.image.description="Local Piper/Kokoro streaming server for MiOS real-time speech synthesis"
Pod=mios-ai.pod
User=831
Volume=/var/lib/mios/piper/models:/models:ro,Z
Volume=/run/mios:/run/mios:Z

[Install]
WantedBy=multi-user.target default.target

[Service]
Delegate=yes
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300s
