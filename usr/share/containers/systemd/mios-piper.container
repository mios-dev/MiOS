# AI-hint: Quadlet container unit for local Piper/Kokoro streaming text-to-speech engine (T-534, AGY-2132).
# AI-doc: usr/share/doc/mios/manual/ch79-streaming-tts-piper.md
# /usr/share/containers/systemd/mios-piper.container

[Unit]
Description='MiOS' Piper/Kokoro Streaming TTS Engine (piper-http)
Documentation=https://github.com/rhasspy/piper
After=network-online.target mios-cdi-detect.service
Wants=network-online.target

[Container]
ContainerName=mios-piper
Image=ghcr.io/rhasspy/piper:latest
Pod=mios-ai.pod
Environment=PORT=${MIOS_PORT_PIPER:-8179}
EnvironmentFile=/etc/mios/install.env
Exec=--model /models/en_US-lessac-medium.onnx --port ${MIOS_PORT_PIPER:-8179} --host 0.0.0.0
Volume=/usr/share/mios/piper/models:/models:ro,Z
Volume=/run/mios:/run/mios:Z
HealthCmd=curl -fsS http://localhost:${MIOS_PORT_PIPER:-8179}/health || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=30s
HealthTimeout=10s
Label=org.opencontainers.image.title=mios-piper
Label=org.opencontainers.image.description="Local Piper/Kokoro streaming server for MiOS real-time speech synthesis"

[Install]
WantedBy=multi-user.target default.target

[Service]
Delegate=yes
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300s
