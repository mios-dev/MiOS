# AI-hint: MiOS mios-sunshine container. (WS-7 pods-as-SSOT).
# DO NOT EDIT -- regenerate via tools/generate-pod-quadlets.py from [containers.mios-sunshine] in mios.toml.
# /usr/share/containers/systemd/mios-sunshine.container

[Unit]
After=graphical-session.target
ConditionUser=!@system
Description='MiOS' Sunshine Low-Latency Streaming Server (portal/PipeWire capture, HW encode)
Documentation=https://docs.lizardbyte.dev/projects/sunshine
PartOf=graphical-session.target

[Container]
AddCapability=CAP_SYS_NICE
AddDevice=/dev/dri
AddDevice=/dev/uinput
AddDevice=nvidia.com/gpu=all
ContainerName=mios-sunshine
Environment=XDG_RUNTIME_DIR=%t
Environment=WAYLAND_DISPLAY=wayland-0
Environment=PULSE_SERVER=unix:%t/pulse/native
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=HOME=%h
EnvironmentFile=/etc/mios/install.env
Exec=capture=portal
Group=%G
GroupAdd=keep-groups
HealthCmd=curl -fsS http://localhost:47990/ || exit 1
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s
HealthTimeout=10s
Image=docker.io/lizardbyte/sunshine:latest-ubuntu-26.10
Label=org.opencontainers.image.title=mios-sunshine
Label=org.opencontainers.image.description="Low-latency Sunshine/Moonlight streaming server with multi-vendor hardware encoding and portal/PipeWire capture"
Network=host
SecurityLabelDisable=true
User=%U
UserNS=keep-id
Volume=%t:%t:ro
Volume=%h/.config/sunshine:%h/.config/sunshine

[Install]
WantedBy=graphical-session.target

[Service]
Delegate=yes
ExecStartPre=/usr/bin/mkdir -p %h/.config/sunshine
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
