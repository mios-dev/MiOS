#!/usr/bin/env bash
# AI-hint: Provides a shell-compatible entry point for the MiOS agent, mapping the @ symbol to the mios CLI to unify interactive and piped command inputs into a single agent interface.
# AI-related: mios-agent

set -euo pipefail

prompt="$*"
if [ -z "$prompt" ] && [ ! -t 0 ]; then
    prompt="$(cat)"
fi
if [ -z "$prompt" ]; then
    echo "@: empty prompt. Usage: @ <query>  or  echo Q | @" >&2
    exit 2
fi
exec /usr/bin/mios "$prompt"
