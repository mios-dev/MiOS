#!/usr/bin/env bash
# AI-hint: Thin wrapper for the Hermes-Agent CLI located in the system venv; provides interactive chat, gateway status, and kanban commands by proxying to the native hermes binary at /usr/lib/mios/agents/.venv/bin/hermes.
# AI-related: /usr/lib/mios/agents/.venv/bin/hermes., /usr/lib/mios/agents/.venv, /usr/lib/mios/agents/.venv/bin/hermes, mios-hermes, mios-hermes-firstboot, hermes-agent.service
set -euo pipefail

HERMES_BIN=/usr/lib/mios/agents/.venv/bin/hermes
if [[ ! -x "$HERMES_BIN" ]]; then
    echo "Hermes: direct install not found at $HERMES_BIN" >&2
    echo "  the Hermes-Agent host install hasn't run" >&2
    echo "" >&2
    exit 127
fi

exec "$HERMES_BIN" "$@"
