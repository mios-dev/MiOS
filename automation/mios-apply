#!/usr/bin/env bash
# AI-hint: The ONE unified MiOS apply engine -- materializes Git=$ROOT (via lib/root-merge.sh) then
# AI-functions: apply_substrate_classes, apply_list_stages, main
# AI-related: automation/lib/root-merge.sh, automation/lib/stage-runner.sh, automation/build.sh, build-mios.sh, build-mios.ps1, usr/libexec/mios/mios-apply
set -uo pipefail

APPLY_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # automation/
MIOS_SUBSTRATE="${MIOS_SUBSTRATE:-oci-bake}"
MIOS_ROOT="${MIOS_ROOT:-/}"

apply_substrate_classes() {
    case "$1" in
        oci-bake)   echo "Universal bake-only dev-only boot-only" ;;
        bootc-live) echo "Universal boot-only" ;;
        wsl-dev)    echo "Universal dev-only" ;;
        fhs-host)   echo "Universal boot-only" ;;
        *)          echo "" ;;
    esac
}

APPLY_SKIP="01-system-files-overlay.sh 97-ssot-lint.sh 98-drift-checks.sh 99-postcheck.sh"

apply_list_stages() {
    local allowed base cls s
    allowed=" $(apply_substrate_classes "$MIOS_SUBSTRATE") "
    shopt -s nullglob
    for s in "$APPLY_DIR"/[0-9][0-9]-*.sh; do
        base="$(basename "$s")"
        case " $APPLY_SKIP " in *" $base "*) continue ;; esac
        cls="$(grep -oE '^# MIOS_APPLY_CLASS=[a-z-]+' "$s" | head -1 | cut -d= -f2)"
        [ -z "$cls" ] && cls="universal"   # unclassified defaults universal; the drift-gate enforces exactly one
        case "$allowed" in *" $cls "*) echo "$base" ;; esac
    done
    shopt -u nullglob
}

main() {
    case "${1:-}" in
        --list-stages)
            if [ -z "$(apply_substrate_classes "$MIOS_SUBSTRATE")" ]; then
                echo "[mios-apply] unknown MIOS_SUBSTRATE='$MIOS_SUBSTRATE'" >&2
                return 2
            fi
            apply_list_stages
            ;;
        *)
            echo "[mios-apply] substrate=$MIOS_SUBSTRATE root=$MIOS_ROOT" >&2
            echo "[mios-apply] full-apply lands in Phase 2; use" >&2
            return 0
            ;;
    esac
}

main "$@"
